# Android ARM64 独立构建参数；不复用 Windows PC 的 common.gn。
target_os = "android"
target_cpu = "arm64"
arm_control_flow_integrity = "pac"

is_official_build = false
is_debug = false
is_component_build = false
use_thin_lto = false
thin_lto_enable_optimizations = false
dcheck_always_on = true

symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_rust = true
pdf_enable_rust_png = false
pdf_use_skia = true

# 告警不作为编译或链接失败；真正的错误仍然阻断构建。
treat_warnings_as_errors = false
fatal_linker_warnings = false

# Android 编译统一在 WSL Linux 内执行，使用已核实的 Linux 工具链路径。
android_sdk_root = "/home/gaoyang/Android/Sdk"
android_sdk_platform_version = "36"
android_sdk_build_tools_version = "36.0.0"
android_ndk_root = "/home/gaoyang/Android/Sdk/ndk/28.0.13004108"
android_ndk_version = "r28"
android_ndk_api_level = 35
android_sdk_tools_bundle_aapt2_dir =
    "/home/gaoyang/Android/Sdk/build-tools/36.0.0"
clang_base_path = "/home/gaoyang/chromium-tools/clang"
rust_sysroot_absolute =
    "/home/gaoyang/.rustup/toolchains/nightly-2025-11-12-x86_64-unknown-linux-gnu"
rust_bindgen_root = "/home/gaoyang/chromium-tools/rust-toolchain-fixed"
rustc_version = "rustc 1.93.0-nightly (25d319a0f 2025-11-11)"

# 保留活跃输出已有检查策略；本次不新增关闭项或改变功能。
android_static_analysis = "off"
use_errorprone_java_compiler = false

# 原 PC 配置导入中实际生效的项目参数，独立登记以免两端配置耦合。
# 逗号分隔的完整 Origin 列表；协议、主机和端口必须精确匹配。
# 默认仅允许本机开发服务，生产编译时应在 args.gn 覆盖为实际 SaaS 来源。
fingerprint_saas_allowed_origins =
    "http://127.0.0.1:8787,http://localhost:8787"
build_with_tflite_lib = false
chrome_pgo_phase = 0
clang_use_chrome_plugins = false
disable_fieldtrial_testing_config = true
enable_hangout_services_extension = false
enable_mdns = false
enable_remoting = false
enable_reporting = false
enable_service_discovery = false
enable_widevine = false
exclude_unwind_tables = true
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0
use_official_google_api_keys = false
use_unofficial_version_number = false
is_clang = true
use_lld = true
