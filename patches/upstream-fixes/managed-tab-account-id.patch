+++ b/chrome/browser/ui/browser_tab_strip_model_delegate.cc
@@ -238,7 +238,24 @@
 // static
 std::string ManagedTabContext::GenerateId() {
   return base::Uuid::GenerateRandomV4().AsLowercaseString();
 }
 
+// static
+bool ManagedTabContext::IsValidId(const std::string& id) {
+  if (id.empty() || id.size() > 128) {
+    return false;
+  }
+
+  for (unsigned char character : id) {
+    if (!((character >= 'a' && character <= 'z') ||
+          (character >= 'A' && character <= 'Z') ||
+          (character >= '0' && character <= '9') || character == '-' ||
+          character == '_')) {
+      return false;
+    }
+  }
+  return true;
+}
+
 // static
 std::vector<ManagedTabContext*> ManagedTabContext::GetAll() {
@@ -303,14 +303,25 @@
 // static
 ManagedTabContext* ManagedTabContext::CreateNewTab(Browser* browser,
                                                     const GURL& url) {
-  if (!browser) {
-    return nullptr;
-  }
+  return CreateNewTab(browser, url, GenerateId());
+}
 
+// static
+ManagedTabContext* ManagedTabContext::CreateNewTab(
+    Browser* browser,
+    const GURL& url,
+    const std::string& managed_tab_id) {
+  if (!browser || !IsValidId(managed_tab_id)) {
+    return nullptr;
+  }
+  if (FindById(managed_tab_id)) {
+    return nullptr;
+  }
+
   NavigateParams params(
       browser, url.is_empty() ? browser->GetNewTabURL() : url,
       ui::PAGE_TRANSITION_TYPED);
   params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
-  params.managed_tab_id = GenerateId();
+  params.managed_tab_id = managed_tab_id;
   params.pwa_navigation_capturing_force_off = true;
   Navigate(&params);
@@ -333,5 +333,6 @@
 base::Value::Dict ManagedTabContext::GetState() const {
   base::Value::Dict state;
   state.Set("id", id_);
+  state.Set("account_id", id_);
   state.Set("url", current_url_.spec());
   state.Set("title", base::UTF16ToUTF8(title_));
