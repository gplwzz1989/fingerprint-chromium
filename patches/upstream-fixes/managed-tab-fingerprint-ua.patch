+void ManagedTabContext::SetFingerprintUserAgentOverride(
+    const blink::UserAgentOverride& user_agent_override) {
+  if (!web_contents()) {
+    return;
+  }
+
+  if (content::NavigationEntry* entry =
+          web_contents()->GetController().GetLastCommittedEntry()) {
+    entry->SetIsOverridingUserAgent(
+        !user_agent_override.ua_string_override.empty());
+  }
+  web_contents()->SetUserAgentOverride(user_agent_override,
+                                       /*override_in_new_tabs=*/false);
+  fingerprint_user_agent_override_ = web_contents()->GetUserAgentOverride();
+}
