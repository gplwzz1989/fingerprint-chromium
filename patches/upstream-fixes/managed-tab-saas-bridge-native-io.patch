+void ManagementUIHandler::HandleSaasFilesList(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("文件列表参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& input = args[1].GetDict();
+  const base::Value* path_value = input.Find("path");
+  if (path_value && !path_value->is_string()) {
+    RejectJavascriptCallback(args[0], base::Value("文件路径参数无效"));
+    return;
+  }
+  const std::string relative_path =
+      path_value ? path_value->GetString() : std::string();
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (!profile) {
+    RejectJavascriptCallback(args[0], base::Value("当前浏览器配置不可用"));
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&ListSaasFilesOnBlockingThread,
+                     profile->GetPath().AppendASCII(kSaasFilesDirectory),
+                     relative_path),
+      base::BindOnce(&ManagementUIHandler::OnSaasFileResult,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ManagementUIHandler::HandleSaasFilesRead(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("文件读取参数无效"));
+    }
+    return;
+  }
+  const std::string* relative_path = args[1].GetDict().FindString("path");
+  if (!relative_path || relative_path->empty()) {
+    RejectJavascriptCallback(args[0], base::Value("文件路径参数无效"));
+    return;
+  }
+
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (!profile) {
+    RejectJavascriptCallback(args[0], base::Value("当前浏览器配置不可用"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&ReadSaasFileOnBlockingThread,
+                     profile->GetPath().AppendASCII(kSaasFilesDirectory),
+                     *relative_path),
+      base::BindOnce(&ManagementUIHandler::OnSaasFileResult,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ManagementUIHandler::HandleSaasFilesWrite(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("文件写入参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& input = args[1].GetDict();
+  const std::string* relative_path = input.FindString("path");
+  const std::string* encoded_data = input.FindString("dataBase64");
+  if (!relative_path || relative_path->empty() || !encoded_data) {
+    RejectJavascriptCallback(args[0], base::Value("文件写入参数无效"));
+    return;
+  }
+  const std::optional<std::vector<uint8_t>> bytes =
+      base::Base64Decode(*encoded_data);
+  if (!bytes || bytes->size() > kMaxSaasFileBytes) {
+    RejectJavascriptCallback(args[0], base::Value("文件内容无效或超过大小限制"));
+    return;
+  }
+
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (!profile) {
+    RejectJavascriptCallback(args[0], base::Value("当前浏览器配置不可用"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&WriteSaasFileOnBlockingThread,
+                     profile->GetPath().AppendASCII(kSaasFilesDirectory),
+                     *relative_path, *bytes),
+      base::BindOnce(&ManagementUIHandler::OnSaasFileResult,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ManagementUIHandler::OnSaasFileResult(base::Value callback_id,
+                                            base::Value::Dict result) {
+  const std::optional<bool> success = result.FindBool("success");
+  base::Value* value = result.Find("value");
+  if (!success.value_or(false) || !value) {
+    const std::string* error = result.FindString("error");
+    RejectJavascriptCallback(
+        callback_id,
+        base::Value(error ? *error : "文件操作失败"));
+    return;
+  }
+  ResolveJavascriptCallback(callback_id, std::move(*value));
+}
+
+void ManagementUIHandler::HandleSaasHttpRequest(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("原生 HTTP 参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& input = args[1].GetDict();
+  const std::string* url_value = input.FindString("url");
+  if (!url_value) {
+    RejectJavascriptCallback(args[0], base::Value("缺少 HTTP 地址"));
+    return;
+  }
+  const GURL url(*url_value);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    RejectJavascriptCallback(args[0], base::Value("HTTP 地址无效"));
+    return;
+  }
+
+  std::string method = input.FindString("method")
+                           ? *input.FindString("method")
+                           : "GET";
+  method = base::ToUpperASCII(method);
+  if (!net::HttpUtil::IsToken(method)) {
+    RejectJavascriptCallback(args[0], base::Value("HTTP 方法无效"));
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = method;
+  request->credentials_mode =
+      input.FindBool("includeCredentials").value_or(false)
+          ? network::mojom::CredentialsMode::kInclude
+          : network::mojom::CredentialsMode::kOmit;
+
+  if (const base::Value::Dict* headers = input.FindDict("headers")) {
+    for (const auto [name, value] : *headers) {
+      if (!value.is_string() || !net::HttpUtil::IsValidHeaderName(name) ||
+          !net::HttpUtil::IsValidHeaderValue(value.GetString())) {
+        RejectJavascriptCallback(args[0], base::Value("HTTP 请求头无效"));
+        return;
+      }
+      request->headers.SetHeader(name, value.GetString());
+    }
+  }
+
+  std::string request_body;
+  if (const std::string* encoded_body = input.FindString("bodyBase64")) {
+    const std::optional<std::vector<uint8_t>> body =
+        base::Base64Decode(*encoded_body);
+    if (!body || body->size() > kMaxSaasFileBytes) {
+      RejectJavascriptCallback(args[0], base::Value("HTTP 请求正文无效"));
+      return;
+    }
+    request_body.assign(reinterpret_cast<const char*>(body->data()),
+                        body->size());
+  }
+  std::string content_type = "application/octet-stream";
+  if (const std::string* value = input.FindString("contentType")) {
+    if (!net::HttpUtil::IsValidHeaderValue(*value)) {
+      RejectJavascriptCallback(args[0], base::Value("HTTP 内容类型无效"));
+      return;
+    }
+    content_type = *value;
+  }
+
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (!profile) {
+    RejectJavascriptCallback(args[0], base::Value("当前浏览器配置不可用"));
+    return;
+  }
+  auto loader = network::SimpleURLLoader::Create(
+      std::move(request), kSaasBridgeHttpTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(base::Seconds(30));
+  if (input.FindString("bodyBase64")) {
+    loader->AttachStringForUpload(std::move(request_body), content_type);
+  }
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  loader_ptr->DownloadToString(
+      profile->GetURLLoaderFactory().get(),
+      base::BindOnce(&ManagementUIHandler::OnSaasHttpResponse,
+                     weak_factory_.GetWeakPtr(), std::move(loader),
+                     args[0].Clone()),
+      kMaxSaasHttpResponseBytes);
+}
+
+void ManagementUIHandler::OnSaasHttpResponse(
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    base::Value callback_id,
+    std::optional<std::string> response_body) {
+  if (!response_body && loader->NetError() != net::ERR_HTTP_RESPONSE_CODE_FAILURE) {
+    RejectJavascriptCallback(callback_id, base::Value("原生 HTTP 请求失败"));
+    return;
+  }
+
+  int response_code = 0;
+  base::Value::Dict response_headers;
+  if (const network::mojom::URLResponseHead* response_info =
+          loader->ResponseInfo()) {
+    if (response_info->headers) {
+      response_code = response_info->headers->response_code();
+      size_t iterator = 0;
+      std::string name;
+      std::string value;
+      while (response_info->headers->EnumerateHeaderLines(
+          &iterator, &name, &value)) {
+        response_headers.Set(name, value);
+      }
+    }
+  }
+
+  base::Value::Dict result;
+  result.Set("status", response_code);
+  result.Set("headers", std::move(response_headers));
+  result.Set("bodyBase64",
+             base::Base64Encode(response_body.value_or(std::string())));
+  ResolveJavascriptCallback(callback_id, std::move(result));
+}
 
 void ManagementUIHandler::HandleGetSaasSession(
     const base::Value::List& args) {
