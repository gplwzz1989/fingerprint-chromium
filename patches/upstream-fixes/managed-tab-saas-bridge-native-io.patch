+base::Value::Dict MakeSaasFileResult(bool success,
+                                     base::Value value,
+                                     std::string error = {}) {
+  base::Value::Dict result;
+  result.Set("success", success);
+  if (success) {
+    result.Set("value", std::move(value));
+  } else {
+    result.Set("error", std::move(error));
+  }
