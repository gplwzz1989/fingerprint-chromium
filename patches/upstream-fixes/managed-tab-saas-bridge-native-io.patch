+std::optional<base::FilePath> ResolveSaasFilePath(
+    const base::FilePath& root,
+    std::string_view relative_path,
+    bool allow_root,
+    std::string* error) {
+  if (relative_path.empty()) {
+    if (allow_root) {
+      return root;
+    }
+    *error = "文件路径不能为空";
+    return std::nullopt;
+  }
+  if (relative_path.size() > 1024 || relative_path.find('\0') !=
+                                         std::string_view::npos) {
+    *error = "文件路径无效";
+    return std::nullopt;
+  }
+
+  const base::FilePath relative =
+      base::FilePath::FromUTF8Unsafe(std::string(relative_path));
+  if (relative.empty() || relative.IsAbsolute() || relative.ReferencesParent() ||
+      relative == base::FilePath(FILE_PATH_LITERAL("."))) {
+    *error = "文件路径必须位于桥接专用目录内";
+    return std::nullopt;
+  }
+  return root.Append(relative);
+}
+
+base::Value::Dict ListSaasFilesOnBlockingThread(base::FilePath root,
+                                                std::string relative_path) {
+  std::string error;
+  const std::optional<base::FilePath> directory = ResolveSaasFilePath(
+      root, relative_path, /*allow_root=*/true, &error);
+  if (!directory) {
+    return MakeSaasFileResult(false, base::Value(), std::move(error));
+  }
+  if (!base::PathExists(*directory)) {
+    if (relative_path.empty()) {
+      return MakeSaasFileResult(true, base::Value(base::Value::List()));
+    }
+    return MakeSaasFileResult(false, base::Value(), "目录不存在");
+  }
+
+  base::File::Info directory_info;
+  if (!base::GetFileInfo(*directory, &directory_info) ||
+      !directory_info.is_directory) {
+    return MakeSaasFileResult(false, base::Value(), "目标不是目录");
+  }
+
+  base::Value::List entries;
+  base::FileEnumerator enumerator(
+      *directory, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath current = enumerator.Next(); !current.empty();
+       current = enumerator.Next()) {
+    const base::FileEnumerator::FileInfo info = enumerator.GetInfo();
+    const std::string name = info.GetName().AsUTF8Unsafe();
+    base::Value::Dict entry;
+    entry.Set("name", name);
+    entry.Set("path", relative_path.empty() ? name
+                                             : relative_path + "/" + name);
+    entry.Set("directory", info.IsDirectory());
+    entry.Set("size", static_cast<double>(
+                          info.IsDirectory() ? 0 : info.GetSize()));
+    entries.Append(std::move(entry));
+  }
+  return MakeSaasFileResult(true, base::Value(std::move(entries)));
+}
+
+base::Value::Dict ReadSaasFileOnBlockingThread(base::FilePath root,
+                                               std::string relative_path) {
+  std::string error;
+  const std::optional<base::FilePath> file = ResolveSaasFilePath(
+      root, relative_path, /*allow_root=*/false, &error);
+  if (!file) {
+    return MakeSaasFileResult(false, base::Value(), std::move(error));
+  }
+
+  base::File::Info info;
+  if (!base::GetFileInfo(*file, &info) || info.is_directory) {
+    return MakeSaasFileResult(false, base::Value(), "文件不存在");
+  }
+  if (info.size < 0 || static_cast<uint64_t>(info.size) > kMaxSaasFileBytes) {
+    return MakeSaasFileResult(false, base::Value(), "文件超过允许读取大小");
+  }
+  const std::optional<std::vector<uint8_t>> bytes = base::ReadFileToBytes(*file);
+  if (!bytes) {
+    return MakeSaasFileResult(false, base::Value(), "文件读取失败");
+  }
+
+  base::Value::Dict result;
+  result.Set("path", relative_path);
+  result.Set("size", static_cast<int>(bytes->size()));
+  result.Set("dataBase64", base::Base64Encode(*bytes));
+  return MakeSaasFileResult(true, base::Value(std::move(result)));
+}
+
+base::Value::Dict WriteSaasFileOnBlockingThread(
+    base::FilePath root,
+    std::string relative_path,
+    std::vector<uint8_t> bytes) {
+  std::string error;
+  const std::optional<base::FilePath> file = ResolveSaasFilePath(
+      root, relative_path, /*allow_root=*/false, &error);
+  if (!file) {
+    return MakeSaasFileResult(false, base::Value(), std::move(error));
+  }
+  if (bytes.size() > kMaxSaasFileBytes) {
+    return MakeSaasFileResult(false, base::Value(), "文件超过允许写入大小");
+  }
+  if (!base::CreateDirectory(file->DirName())) {
+    return MakeSaasFileResult(false, base::Value(), "文件目录创建失败");
+  }
+
+  const std::string contents(
+      reinterpret_cast<const char*>(bytes.data()), bytes.size());
+  if (base::WriteFile(*file, contents) != static_cast<int>(contents.size())) {
+    return MakeSaasFileResult(false, base::Value(), "文件写入失败");
+  }
+
+  base::Value::Dict result;
+  result.Set("path", relative_path);
+  result.Set("size", static_cast<int>(bytes.size()));
+  return MakeSaasFileResult(true, base::Value(std::move(result)));
+}
