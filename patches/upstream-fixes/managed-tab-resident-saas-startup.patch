@@ -3068,5 +3068,32 @@ void Browser::OnTabInsertedAt(WebContents* contents, int index) {
 
   SetAsDelegate(contents, true);
 
+  if (is_type_normal()) {
+    // 插入结束后检查常驻控制台，覆盖首次启动和会话恢复，并避免重入 TabStrip。
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce([](base::WeakPtr<Browser> browser) {
+          if (!browser || browser->is_delete_scheduled_ ||
+              browser->tab_strip_model()->closing_all()) {
+            return;
+          }
+          TabStripModel* tabs = browser->tab_strip_model();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (tabs->GetWebContentsAt(i)->GetVisibleURL().host() ==
+                chrome::kChromeUIFingerprintManagerHost) {
+              // 管理器保持普通宽度以显示完整标题；关闭保护由
+              // TabStripModel::PolicyAllowsTabClosing 独立负责。
+              if (tabs->IsTabPinned(i)) {
+                tabs->SetTabPinned(i, false);
+              }
+              return;
+            }
+          }
+          content::WebContents* control = chrome::AddSelectedTabWithURL(
+              browser.get(), GURL("chrome://fingerprint-manager/"),
+              ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+          (void)control;
+        }, AsWeakPtr()));
+  }
+
   sessions::SessionTabHelper::FromWebContents(contents)->SetWindowID(
       session_id());
