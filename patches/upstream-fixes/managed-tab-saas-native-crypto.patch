+base::Value::Dict ProcessSaasSnapshotCryptoOnBlockingThread(
+    std::string method, base::Value::Dict input) {
+  const std::string* password = input.FindString("password");
+  const std::string* account_id = input.FindString("accountId");
+  if (!password || password->size() < 12 || password->size() > 4096 ||
+      !account_id || !ManagedTabContext::IsValidId(*account_id)) {
+    return MakeSaasFileResult(false, base::Value(), "快照密码或账号标识无效");
+  }
+  const bool encrypt = method == "crypto.encryptSnapshot";
+  std::string salt, nonce, ciphertext, tag, plaintext;
+  int iterations = 600000;
+  if (encrypt) {
+    const base::Value::Dict* snapshot = input.FindDict("snapshot");
+    if (!snapshot || snapshot->FindInt("schema_version") != 1 ||
+        !snapshot->FindString("account_id") ||
+        *snapshot->FindString("account_id") != *account_id ||
+        !base::JSONWriter::Write(*snapshot, &plaintext) ||
+        plaintext.size() > 14 * 1024 * 1024) {
+      return MakeSaasFileResult(false, base::Value(), "账号快照格式无效或内容过大");
+    }
+    salt = base::RandBytesAsString(16);
+    nonce = base::RandBytesAsString(12);
+  } else {
+    const base::Value::Dict* envelope = input.FindDict("envelope");
+    if (!envelope || !envelope->FindString("algorithm") ||
+        *envelope->FindString("algorithm") != "AES-256-GCM" ||
+        !envelope->FindString("kdf") ||
+        *envelope->FindString("kdf") != "PBKDF2-HMAC-SHA-256") {
+      return MakeSaasFileResult(false, base::Value(), "快照加密参数不受支持");
+    }
+    iterations = envelope->FindInt("iterations").value_or(0);
+    auto decode = [&](const char* name, size_t max_bytes, std::string* out) {
+      const std::string* value = envelope->FindString(name);
+      return value && value->size() <= ((max_bytes + 2) / 3) * 4 &&
+             base::Base64Decode(*value, out) && out->size() <= max_bytes;
+    };
+    if (iterations < 600000 || iterations > 2000000 ||
+        !decode("salt", 64, &salt) || salt.size() < 16 ||
+        !decode("nonce", 12, &nonce) || nonce.size() != 12 ||
+        !decode("ciphertext", 16 * 1024 * 1024, &ciphertext) ||
+        ciphertext.size() < 16 || !decode("tag", 16, &tag) || tag.size() != 16) {
+      return MakeSaasFileResult(false, base::Value(), "加密快照格式无效");
+    }
+  }
+
+  struct SnapshotKey {
+    std::string bytes = std::string(32, '\0');
+    ~SnapshotKey() { OPENSSL_cleanse(bytes.data(), bytes.size()); }
+  } key;
+  if (!PKCS5_PBKDF2_HMAC(password->data(), password->size(),
+                        reinterpret_cast<const uint8_t*>(salt.data()),
+                        salt.size(), iterations, EVP_sha256(), key.bytes.size(),
+                        reinterpret_cast<uint8_t*>(key.bytes.data()))) {
+    return MakeSaasFileResult(false, base::Value(), "快照密钥生成失败");
+  }
+  crypto::Aead aead(crypto::Aead::AES_256_GCM);
+  aead.Init(&key.bytes);
+  const std::string aad = "fingerprint-manager:v1:" + *account_id;
+  if (encrypt) {
+    if (!aead.Seal(plaintext, nonce, aad, &ciphertext) || ciphertext.size() < 16) {
+      return MakeSaasFileResult(false, base::Value(), "账号快照加密失败");
+    }
+    tag = ciphertext.substr(ciphertext.size() - 16);
+    ciphertext.resize(ciphertext.size() - 16);
+    base::Value::Dict envelope;
+    envelope.Set("algorithm", "AES-256-GCM");
+    envelope.Set("kdf", "PBKDF2-HMAC-SHA-256");
+    envelope.Set("iterations", iterations);
+    envelope.Set("salt", base::Base64Encode(salt));
+    envelope.Set("nonce", base::Base64Encode(nonce));
+    envelope.Set("ciphertext", base::Base64Encode(ciphertext));
+    envelope.Set("tag", base::Base64Encode(tag));
+    return MakeSaasFileResult(true, base::Value(std::move(envelope)));
+  }
+  ciphertext += tag;
+  if (!aead.Open(ciphertext, nonce, aad, &plaintext)) {
+    return MakeSaasFileResult(false, base::Value(), "快照解密失败，请核对快照密码与账号");
+  }
+  auto snapshot = base::JSONReader::ReadDict(plaintext, base::JSON_PARSE_RFC);
+  if (!snapshot || snapshot->FindInt("schema_version") != 1 ||
+      !snapshot->FindString("account_id") ||
+      *snapshot->FindString("account_id") != *account_id) {
+    return MakeSaasFileResult(false, base::Value(), "账号快照标识或版本无效");
+  }
+  return MakeSaasFileResult(true, base::Value(std::move(*snapshot)));
+}
