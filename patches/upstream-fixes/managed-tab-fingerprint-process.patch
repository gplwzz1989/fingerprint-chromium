+    base::CommandLine* command_line) {
+  if (!storage_partition || !command_line) {
+    return;
+  }
+  const content::StoragePartitionConfig& config =
+      storage_partition->GetConfig();
+  if (config.partition_domain() != kManagedTabPartitionDomain ||
+      config.partition_name().empty()) {
+    return;
+  }
