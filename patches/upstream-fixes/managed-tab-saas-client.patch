+export interface SaasUser {
+  user_id: string;
+  email: string;
+  display_name: string;
+}
+
+export interface SaasWorkspace {
+  workspace_id: string;
+  name: string;
+  role: string;
+}
+
+export interface SaasAccount {
+  account_id: string;
+  workspace_id: string;
+  name: string;
+  labels: string[];
+  revision: number;
+  created_at: string;
+  updated_at: string;
+}
+
+interface SaasSession {
+  access_token: string;
+  refresh_token: string;
+  expires_in: number;
+  user: SaasUser;
+}
+
+interface SaasSnapshotEnvelope {
+  algorithm: 'AES-256-GCM';
+  kdf: 'PBKDF2-HMAC-SHA-256';
+  iterations: number;
+  salt: string;
+  nonce: string;
+  ciphertext: string;
+  tag: string;
+}
+
+interface SaasAccountSnapshot {
+  account_id: string;
+  revision: number;
+  schema_version: number;
+  device_id: string;
+  updated_at: string;
+  envelope: SaasSnapshotEnvelope;
+}
+
+export interface SaasLease {
+  lease_id: string;
+  account_id: string;
+  device_id: string;
+  expires_at: string;
+}
+
+class SaasApiError extends Error {
+  constructor(public readonly status: number, message: string) {
+    super(message);
+    this.name = 'SaasApiError';
+  }
+}
+
+const kSaasSnapshotSchemaVersion = 1;
+const kSaasKdfIterations = 600000;
+const kSaasSnapshotAadPrefix = 'fingerprint-manager:v1:';
+
+export class FingerprintManagerSaasClient {
+  private constructor(
+      private readonly baseUrl_: string, private readonly deviceId_: string,
+      private readonly password_: string, private accessToken_: string,
+      private refreshToken_: string, readonly user: SaasUser) {}
+
+  static async login(
+      baseUrl: string, email: string, password: string,
+      deviceId: string): Promise<FingerprintManagerSaasClient> {
+    const normalizedBaseUrl = normalizeSaasBaseUrl(baseUrl);
+    const response = await fetch(`${normalizedBaseUrl}/api/v1/sessions`, {
+      method: 'POST',
+      headers: {'Content-Type': 'application/json'},
+      credentials: 'omit',
+      body: JSON.stringify({email, password, device_id: deviceId}),
+    });
+    const session = await parseSaasResponse<SaasSession>(response);
+    return new FingerprintManagerSaasClient(
+        normalizedBaseUrl, deviceId, password, session.access_token,
+        session.refresh_token, session.user);
+  }
+
+  async getWorkspaces(): Promise<SaasWorkspace[]> {
+    return this.request_<SaasWorkspace[]>('/api/v1/workspaces');
+  }
+
+  async getAccounts(workspaceId: string): Promise<SaasAccount[]> {
+    const accounts: SaasAccount[] = [];
+    let pageToken = '';
+    do {
+      const query = new URLSearchParams({page_size: '200'});
+      if (pageToken) {
+        query.set('page_token', pageToken);
+      }
+      const page = await this.request_<{
+        items: SaasAccount[], next_page_token?: string,
+      }>(`/api/v1/workspaces/${encodeURIComponent(workspaceId)}/accounts?` +
+         query.toString());
+      accounts.push(...page.items);
+      pageToken = page.next_page_token || '';
+    } while (pageToken);
+    return accounts;
+  }
+
+  async createAccount(
+      workspaceId: string, accountId: string, name: string): Promise<SaasAccount> {
+    return this.request_<SaasAccount>(
+        `/api/v1/workspaces/${encodeURIComponent(workspaceId)}/accounts`, {
+          method: 'POST',
+          body: JSON.stringify({account_id: accountId, name}),
+        });
+  }
+
+  async getAccountSnapshot(accountId: string): Promise<ManagedTabStorageSnapshot> {
+    const response = await this.request_<SaasAccountSnapshot>(
+        `/api/v1/accounts/${encodeURIComponent(accountId)}/snapshot`);
+    if (response.schema_version !== kSaasSnapshotSchemaVersion ||
+        response.account_id !== accountId) {
+      throw new Error('云端账号快照版本或账号标识无效');
+    }
+    const snapshot = await this.decryptSnapshot_(accountId, response.envelope);
+    snapshot.schema_version = response.schema_version;
+    snapshot.account_id = response.account_id;
+    return snapshot;
+  }
+
+  async putAccountSnapshot(
+      accountId: string, revision: number,
+      snapshot: ManagedTabStorageSnapshot): Promise<SaasAccountSnapshot> {
+    const envelope = await this.encryptSnapshot_(accountId, snapshot);
+    return this.request_<SaasAccountSnapshot>(
+        `/api/v1/accounts/${encodeURIComponent(accountId)}/snapshot`, {
+          method: 'PUT',
+          headers: {'If-Match': String(revision)},
+          body: JSON.stringify({
+            schema_version: kSaasSnapshotSchemaVersion,
+            device_id: this.deviceId_,
+            envelope,
+          }),
+        });
+  }
+
+  async acquireLease(accountId: string): Promise<SaasLease> {
+    return this.request_<SaasLease>(
+        `/api/v1/accounts/${encodeURIComponent(accountId)}/leases`, {
+          method: 'POST',
+          body: JSON.stringify({device_id: this.deviceId_}),
+        });
+  }
+
+  async releaseLease(accountId: string, leaseId: string): Promise<void> {
+    await this.request_<unknown>(
+        `/api/v1/accounts/${encodeURIComponent(accountId)}/leases/` +
+            encodeURIComponent(leaseId), {method: 'DELETE'});
+  }
+
+  private async refresh_(): Promise<void> {
+    const response = await fetch(`${this.baseUrl_}/api/v1/sessions/refresh`, {
+      method: 'POST',
+      headers: {'Content-Type': 'application/json'},
+      credentials: 'omit',
+      body: JSON.stringify({
+        refresh_token: this.refreshToken_,
+        device_id: this.deviceId_,
+      }),
+    });
+    const session = await parseSaasResponse<SaasSession>(response);
+    this.accessToken_ = session.access_token;
+    this.refreshToken_ = session.refresh_token;
+  }
+
+  private async request_<T>(path: string, init: RequestInit = {},
+                            canRefresh = true): Promise<T> {
+    const headers = new Headers(init.headers);
+    if (init.body && !headers.has('Content-Type')) {
+      headers.set('Content-Type', 'application/json');
+    }
+    headers.set('Authorization', `Bearer ${this.accessToken_}`);
+    let response = await fetch(`${this.baseUrl_}${path}`, {
+      ...init,
+      headers,
+      credentials: 'omit',
+    });
+    if (response.status === 401 && canRefresh) {
+      await this.refresh_();
+      response = await this.requestResponse_(path, init);
+    }
+    return parseSaasResponse<T>(response);
+  }
+
+  private requestResponse_(path: string, init: RequestInit): Promise<Response> {
+    const headers = new Headers(init.headers);
+    if (init.body && !headers.has('Content-Type')) {
+      headers.set('Content-Type', 'application/json');
+    }
+    headers.set('Authorization', `Bearer ${this.accessToken_}`);
+    return fetch(`${this.baseUrl_}${path}`, {
+      ...init,
+      headers,
+      credentials: 'omit',
+    });
+  }
+
+  private async encryptSnapshot_(
+      accountId: string,
+      snapshot: ManagedTabStorageSnapshot): Promise<SaasSnapshotEnvelope> {
+    const salt = crypto.getRandomValues(new Uint8Array(16));
+    const nonce = crypto.getRandomValues(new Uint8Array(12));
+    const key = await deriveSnapshotKey(this.password_, salt);
+    const plaintext = new TextEncoder().encode(JSON.stringify({
+      ...snapshot,
+      account_id: accountId,
+      schema_version: kSaasSnapshotSchemaVersion,
+    }));
+    const encrypted = new Uint8Array(await crypto.subtle.encrypt(
+        {
+          name: 'AES-GCM',
+          iv: nonce as unknown as BufferSource,
+          additionalData: snapshotAad(accountId) as unknown as BufferSource,
+        },
+        key, plaintext));
+    const tag = encrypted.slice(encrypted.length - 16);
+    const ciphertext = encrypted.slice(0, encrypted.length - 16);
+    return {
+      algorithm: 'AES-256-GCM',
+      kdf: 'PBKDF2-HMAC-SHA-256',
+      iterations: kSaasKdfIterations,
+      salt: encodeBase64(salt),
+      nonce: encodeBase64(nonce),
+      ciphertext: encodeBase64(ciphertext),
+      tag: encodeBase64(tag),
+    };
+  }
+
+  private async decryptSnapshot_(
+      accountId: string,
+      envelope: SaasSnapshotEnvelope): Promise<ManagedTabStorageSnapshot> {
+    if (envelope.algorithm !== 'AES-256-GCM' ||
+        envelope.kdf !== 'PBKDF2-HMAC-SHA-256' ||
+        envelope.iterations < kSaasKdfIterations) {
+      throw new Error('云端账号快照加密参数不受支持');
+    }
+    const salt = decodeBase64(envelope.salt);
+    const nonce = decodeBase64(envelope.nonce);
+    const ciphertext = decodeBase64(envelope.ciphertext);
+    const tag = decodeBase64(envelope.tag);
+    const encrypted = new Uint8Array(ciphertext.length + tag.length);
+    encrypted.set(ciphertext);
+    encrypted.set(tag, ciphertext.length);
+    const key = await deriveSnapshotKey(this.password_, salt);
+    let plaintext: ArrayBuffer;
+    try {
+      plaintext = await crypto.subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv: nonce as unknown as BufferSource,
+            additionalData: snapshotAad(accountId) as unknown as BufferSource,
+          },
+          key, encrypted);
+    } catch {
+      throw new Error('无法解密云端账号快照，请确认登录密码正确');
+    }
+    let snapshot: ManagedTabStorageSnapshot;
+    try {
+      snapshot = JSON.parse(new TextDecoder().decode(plaintext)) as
+          ManagedTabStorageSnapshot;
+    } catch {
+      throw new Error('云端账号快照内容无效');
+    }
+    if (!snapshot || snapshot.account_id !== accountId ||
+        !Array.isArray(snapshot.cookies) || !snapshot.local_storage ||
+        typeof snapshot.local_storage !== 'object') {
+      throw new Error('云端账号快照结构无效');
+    }
+    return snapshot;
+  }
+}
+
+export function getSaasErrorMessage(error: unknown): string {
+  if (error instanceof Error && error.message) {
+    return error.message;
+  }
+  return 'SaaS 操作失败，请稍后重试';
+}
+
+function normalizeSaasBaseUrl(value: string): string {
+  const trimmed = value.trim().replace(/\/+$/, '');
+  let url: URL;
+  try {
+    url = new URL(trimmed);
+  } catch {
+    throw new Error('SaaS 地址格式无效');
+  }
+  if (url.protocol !== 'https:' &&
+      !(url.protocol === 'http:' &&
+        (url.hostname === 'localhost' || url.hostname === '127.0.0.1'))) {
+    throw new Error('SaaS 地址必须使用 HTTPS');
+  }
+  return url.toString().replace(/\/+$/, '');
+}
+
+async function parseSaasResponse<T>(response: Response): Promise<T> {
+  let body: any = null;
+  try {
+    body = await response.json();
+  } catch {
+    // Use a stable user-facing message for an empty or malformed response.
+  }
+  if (!response.ok) {
+    throw new SaasApiError(
+        response.status, typeof body?.message === 'string' ? body.message :
+                                                              'SaaS 服务请求失败');
+  }
+  return body as T;
+}
+
+async function deriveSnapshotKey(password: string, salt: Uint8Array):
+    Promise<CryptoKey> {
+  const baseKey = await crypto.subtle.importKey(
+      'raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+      {
+        name: 'PBKDF2',
+        salt: salt as unknown as BufferSource,
+        iterations: kSaasKdfIterations,
+        hash: 'SHA-256',
+      },
+      baseKey, {name: 'AES-GCM', length: 256}, false, ['encrypt', 'decrypt']);
+}
+
+function snapshotAad(accountId: string): Uint8Array {
+  return new TextEncoder().encode(kSaasSnapshotAadPrefix + accountId);
+}
+
+function encodeBase64(value: Uint8Array): string {
+  let binary = '';
+  for (const byte of value) {
+    binary += String.fromCharCode(byte);
+  }
+  return btoa(binary);
+}
+
+function decodeBase64(value: string): Uint8Array {
+  const binary = atob(value);
+  const bytes = new Uint8Array(binary.length);
+  for (let index = 0; index < binary.length; ++index) {
+    bytes[index] = binary.charCodeAt(index);
+  }
+  return bytes;
+}
