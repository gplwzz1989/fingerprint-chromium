+        if (!ThreadUtils.runningOnUiThread() || !isNativeInitialized() || isIncognito() ||
+                !isInitializationComplete() || !authority.isActive()) throw new SaasBridgeDispatcher.NativeRequestException("原生网络环境尚未准备好，请重试");
