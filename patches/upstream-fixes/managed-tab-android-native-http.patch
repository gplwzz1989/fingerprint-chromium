+static void JNI_TabModelJniBridge_StartSaasHttpRequest(
+    JNIEnv* env, Profile* profile, const JavaParamRef<jobject>& java_contents,
+    const std::string& options, const JavaParamRef<jobject>& java_request) {
+  base::android::ScopedJavaGlobalRef<jobject> request(java_request);
+  auto authority = base::BindRepeating(
+      [](const base::android::ScopedJavaGlobalRef<jobject>& request) {
+        return Java_TabModelJniBridge_isSaasHttpRequestActive(AttachCurrentThread(), request);
+      }, request);
+  auto complete = base::BindOnce(
+      [](base::android::ScopedJavaGlobalRef<jobject> request, base::Value::Dict reply) {
+        Java_TabModelJniBridge_completeSaasHttpRequest(AttachCurrentThread(), request,
+            base::WriteJson(reply).value_or("{\"ok\":false,\"error\":\"原生 HTTP 响应无效\"}"));
+      }, request);
+  auto parsed = options.size() <= 14 * 1024 * 1024 ?
+      base::JSONReader::ReadDict(options, base::JSON_PARSE_RFC) : std::nullopt;
+  if (!parsed) {
+    base::Value::Dict error; error.Set("ok", false); error.Set("error", "HTTP 请求格式或大小无效");
+    std::move(complete).Run(std::move(error)); return;
+  }
+  chrome::android::SaasNativeHttp::Start(profile, WebContents::FromJavaWebContents(java_contents),
+      *parsed, std::move(authority), std::move(complete));
+}
