+            String id = saasString(args, "tabId", 128, false);
+            Tab target = null;
+            for (int i = 0; i < getCount(); i++) {
+                Tab tab = getTabAt(i);
+                if (tab == null || tab.isClosing()) continue;
+                Map<String, Object> state = readSaasAccountState(tab);
+                if (state != null && id.equals(state.get("id"))) { target = tab; break; }
+            }
+            if (target == null || isResidentSaasTab(target)) throw new SaasBridgeDispatcher.NativeRequestException("指定的隔离账号标签不存在");
+            if (target.isFrozen()) target.loadIfNeeded(TabLoadIfNeededCaller.OTHER);
+            contents = target.getWebContents();
+            if (contents == null || !TabModelJniBridgeJni.get().isSaasAccountWebContents(contents)) throw new SaasBridgeDispatcher.NativeRequestException("指定的隔离账号网络环境未就绪");
+        }
+        if (!authority.isActive()) throw new SaasBridgeDispatcher.NativeRequestException("页面授权已失效，HTTP 请求已停止");
+        SaasHttpRequest request = new SaasHttpRequest(authority);
+        TabModelJniBridgeJni.get().startSaasHttpRequest(getProfile(), contents,
+                SaasBridgeDispatcher.encodeNativePayload(args), request);
+        return request.completion;
+    }
