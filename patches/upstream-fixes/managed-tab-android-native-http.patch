+        catch (RuntimeException error) { return false; }
+    }
+
+    @CalledByNative
+    private static void completeSaasHttpRequest(SaasHttpRequest request, @JniType("std::string") String json) {
+        if (request.completion.isDone()) return;
+        try {
+            if (!isSaasHttpRequestActive(request)) throw new SaasBridgeDispatcher.NativeRequestException("页面授权已失效，HTTP 请求已停止");
+            Map<String, Object> reply = SaasBridgeDispatcher.decodeNativeReply(json);
+            if (!Boolean.TRUE.equals(reply.get("ok"))) {
+                Object message = reply.get("error");
+                throw new SaasBridgeDispatcher.NativeRequestException(message instanceof String ? (String) message : "HTTP 请求失败，请重试");
+            }
+            request.completion.complete(reply.get("result"));
+        } catch (RuntimeException error) {
