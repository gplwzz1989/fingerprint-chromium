+void ManagementUIHandler::HandleConfigureManagedTabFingerprint(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 3 || !args[1].is_string() || !args[2].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("指纹配置参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& config = args[2].GetDict();
+  const std::string* user_agent = config.FindString("user_agent");
+  const base::Value* hardware_concurrency_value =
+      config.Find("hardware_concurrency");
+
+  if (!user_agent || user_agent->size() > 512 ||
+      !hardware_concurrency_value || !hardware_concurrency_value->is_int() ||
+      hardware_concurrency_value->GetInt() < 0 ||
+      hardware_concurrency_value->GetInt() > 64) {
+    RejectJavascriptCallback(args[0], base::Value("指纹配置参数无效"));
+    return;
+  }
+
+  const int hardware_concurrency = hardware_concurrency_value->GetInt();
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context || !context->SetFingerprintUserAgent(*user_agent) ||
+      !context->SetFingerprintHardwareConcurrency(hardware_concurrency)) {
+    RejectJavascriptCallback(args[0], base::Value("无法应用指纹配置"));
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], context->GetState());
+}
