+std::vector<std::string> GetAllowedSaasOrigins() {
+  return base::SplitString(BUILDFLAG(FINGERPRINT_SAAS_ALLOWED_ORIGINS), ",",
+                           base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY);
+}
+
+bool IsAllowedSaasOrigin(const std::string& value) {
+  const GURL url(value);
+  if (!url.is_valid() || url.has_username() || url.has_password() ||
+      (!url.SchemeIs("http") && !url.SchemeIs("https"))) {
+    return false;
+  }
+  if (url::Origin::Create(url).Serialize() != value) {
+    return false;
+  }
+  return base::Contains(GetAllowedSaasOrigins(), value);
+}
