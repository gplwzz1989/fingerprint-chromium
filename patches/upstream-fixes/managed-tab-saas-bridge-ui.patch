@@ -117,3 +125,79 @@ export class FingerprintManagerUiElement extends CrLitElement {
+  override disconnectedCallback() {
+    window.removeEventListener('message', this.onExternalSaasMessage_);
+    super.disconnectedCallback();
+  }
+
+  protected onOpenExternalSaas_() {
+    const input =
+        this.shadowRoot.querySelector<HTMLInputElement>('#externalSaasUrl');
+    const value = input?.value.trim() || '';
+    let url: URL;
+    try {
+      url = new URL(value);
+    } catch {
+      this.externalSaasError_ = '独立 Web 地址格式无效';
+      return;
+    }
+    if (!this.saasBridgeAllowedOrigins_.includes(url.origin)) {
+      this.externalSaasError_ =
+          '该来源未在客户端编译白名单中，请重新配置后编译';
+      return;
+    }
+    this.externalSaasError_ = '';
+    this.externalSaasFrameUrl_ = url.href;
+  }
+
+  protected onCloseExternalSaas_() {
+    this.externalSaasFrameUrl_ = '';
+    this.externalSaasError_ = '';
+  }
+
+  private async loadSaasBridgePolicy_() {
+    try {
+      const policy = await this.browserProxy_.getSaasBridgePolicy();
+      this.saasBridgeAllowedOrigins_ = policy.allowed_origins;
+    } catch {
+      this.saasBridgeAllowedOrigins_ = [];
+    }
+  }
+
+  private onExternalSaasMessage_ = (event: MessageEvent) => {
+    const frame =
+        this.shadowRoot?.querySelector<HTMLIFrameElement>('#externalSaasFrame');
+    if (!frame || event.source !== frame.contentWindow) {
+      return;
+    }
+    const message = event.data as {
+      type?: string,
+      requestId?: string,
+      method?: string,
+      args?: unknown,
+    };
+    if (!message || message.type !== 'fingerprint-saas-bridge:request' ||
+        typeof message.requestId !== 'string' ||
+        typeof message.method !== 'string') {
+      return;
+    }
+    const source = event.source as Window;
+    const respond = (payload: Record<string, unknown>) => {
+      source.postMessage({
+        type: 'fingerprint-saas-bridge:response',
+        requestId: message.requestId,
+        ...payload,
+      }, event.origin);
+    };
+    if (!this.saasBridgeAllowedOrigins_.includes(event.origin)) {
+      respond({ok: false, error: '页面来源未在编译白名单中'});
+      return;
+    }
+    this.browserProxy_.requestSaasBridge(
+        event.origin, message.method, message.args || {}).then(
+        result => respond({ok: true, result}),
+        error => respond({
+          ok: false,
+          error: error instanceof Error ? error.message : '原生桥请求失败',
+        }));
+  };
   protected onRefresh_() {
     this.getManagedTabs_();
   }
