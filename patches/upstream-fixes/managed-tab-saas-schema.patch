diff --git a/chrome/browser/ui/webui/management/management_ui_handler.cc b/chrome/browser/ui/webui/management/management_ui_handler.cc
--- a/chrome/browser/ui/webui/management/management_ui_handler.cc
+++ b/chrome/browser/ui/webui/management/management_ui_handler.cc
@@ -112,5 +112,7 @@
 namespace {
 
+constexpr int kManagedTabSnapshotSchemaVersion = 1;
+
 #if !BUILDFLAG(IS_CHROMEOS)
 
 bool IsBrowserManaged() {
@@ -963,5 +965,6 @@ void ManagementUIHandler::OnManagedTabStorageSnapshot(
   }
 
   base::Value::Dict result;
+  result.Set("schema_version", kManagedTabSnapshotSchemaVersion);
   result.Set("cookies", std::move(cookies));
   result.Set("local_storage", std::move(snapshot.local_storage));
@@ -994,6 +997,13 @@ void ManagementUIHandler::HandleWriteManagedTabStorageSnapshot(
   }
 
   const base::Value::Dict& snapshot = args[2].GetDict();
+  if (const base::Value* schema_version = snapshot.Find("schema_version")) {
+    if (!schema_version->is_int() ||
+        schema_version->GetInt() != kManagedTabSnapshotSchemaVersion) {
+      RejectJavascriptCallback(args[0], base::Value("不支持的存储快照版本"));
+      return;
+    }
+  }
   if (!snapshot.FindList("cookies") || !snapshot.FindDict("local_storage")) {
     RejectJavascriptCallback(args[0], base::Value("存储快照格式无效"));
     return;
