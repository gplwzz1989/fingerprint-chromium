+bool ManagedTabContext::IsStorageWriteTargetCurrent(
+    const GURL& storage_url) const {
+  if (!web_contents() || current_url_ != storage_url) {
+    return false;
+  }
+
+  content::RenderFrameHost* frame_host =
+      web_contents()->GetPrimaryMainFrame();
+  return frame_host && frame_host->IsRenderFrameLive() &&
+         frame_host->GetLastCommittedURL() == storage_url;
+}
