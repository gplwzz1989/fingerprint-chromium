diff --git a/chrome/browser/resources/management/management_ui.css b/chrome/browser/resources/management/management_ui.css
--- a/chrome/browser/resources/management/management_ui.css
+++ b/chrome/browser/resources/management/management_ui.css
@@ -214,0 +215,269 @@
+
+.managed-tabs-section {
+  background: linear-gradient(135deg, var(--google-grey-900), #1f3348);
+  border-radius: 12px;
+  color: var(--google-grey-100);
+  margin: 20px;
+  min-height: 0;
+  overflow: hidden;
+  padding: 24px;
+  position: relative;
+}
+
+.managed-tabs-section::before {
+  background: #8ab4f8;
+  border-radius: 50%;
+  content: '';
+  height: 180px;
+  opacity: .12;
+  position: absolute;
+  right: -70px;
+  top: -100px;
+  width: 180px;
+}
+
+.managed-tabs-heading {
+  align-items: flex-start;
+  display: flex;
+  gap: 20px;
+  justify-content: space-between;
+  position: relative;
+}
+
+.managed-tabs-kicker {
+  color: #8ab4f8;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 1.2px;
+  text-transform: uppercase;
+}
+
+.managed-tabs-heading h2 {
+  color: var(--google-grey-100);
+  font-size: 21px;
+  margin: 6px 0 0;
+}
+
+.managed-tabs-heading p {
+  color: var(--google-grey-300);
+  font-size: 13px;
+  margin: 8px 0 0;
+}
+
+.managed-tabs-count {
+  border: 1px solid rgba(138, 180, 248, .45);
+  border-radius: 20px;
+  color: #8ab4f8;
+  flex-shrink: 0;
+  font-size: 12px;
+  padding: 6px 10px;
+}
+
+.managed-tabs-create {
+  align-items: center;
+  display: flex;
+  gap: 10px;
+  margin-top: 20px;
+  position: relative;
+}
+
+.managed-tabs-create label {
+  color: var(--google-grey-300);
+  font-size: 12px;
+  font-weight: 500;
+  white-space: nowrap;
+}
+
+.managed-tabs-create input,
+.managed-tab-navigation-input {
+  background: rgba(0, 0, 0, .22);
+  border: 1px solid rgba(255, 255, 255, .24);
+  border-radius: 6px;
+  box-sizing: border-box;
+  color: var(--google-grey-100);
+  min-width: 0;
+  outline: none;
+  padding: 9px 11px;
+}
+
+.managed-tabs-create input {
+  flex: 1;
+}
+
+.managed-tabs-create input::placeholder,
+.managed-tab-navigation-input::placeholder {
+  color: var(--google-grey-400);
+}
+
+.managed-tabs-create input:focus,
+.managed-tab-navigation-input:focus {
+  border-color: #8ab4f8;
+  box-shadow: 0 0 0 2px rgba(138, 180, 248, .2);
+}
+
+.managed-tab-primary,
+.managed-tab-secondary,
+.managed-tab-danger {
+  border: 0;
+  border-radius: 6px;
+  cursor: pointer;
+  font-size: 12px;
+  font-weight: 500;
+  min-height: 34px;
+  padding: 0 13px;
+  transition: background-color 120ms ease, transform 120ms ease;
+  white-space: nowrap;
+}
+
+.managed-tab-primary:active,
+.managed-tab-secondary:active,
+.managed-tab-danger:active {
+  transform: translateY(1px);
+}
+
+.managed-tab-primary {
+  background: #8ab4f8;
+  color: #17283a;
+}
+
+.managed-tab-primary:hover {
+  background: #aecbfa;
+}
+
+.managed-tab-secondary {
+  background: rgba(255, 255, 255, .12);
+  color: var(--google-grey-100);
+}
+
+.managed-tab-secondary:hover {
+  background: rgba(255, 255, 255, .2);
+}
+
+.managed-tab-danger {
+  background: rgba(242, 139, 130, .14);
+  color: #f28b82;
+}
+
+.managed-tab-danger:hover {
+  background: rgba(242, 139, 130, .25);
+}
+
+.managed-tab-error {
+  background: rgba(242, 139, 130, .14);
+  border-left: 3px solid #f28b82;
+  color: #f28b82;
+  font-size: 12px;
+  margin-top: 14px;
+  padding: 8px 10px;
+}
+
+.managed-tabs-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-top: 18px;
+  position: relative;
+}
+
+.managed-tab-row {
+  align-items: stretch;
+  background: rgba(255, 255, 255, .08);
+  border: 1px solid rgba(255, 255, 255, .1);
+  border-radius: 8px;
+  display: flex;
+  gap: 16px;
+  justify-content: space-between;
+  padding: 14px;
+}
+
+.managed-tab-details {
+  min-width: 0;
+}
+
+.managed-tab-title {
+  color: var(--google-grey-100);
+  font-size: 14px;
+  font-weight: 500;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.managed-tab-url {
+  color: var(--google-grey-300);
+  font-family: monospace;
+  font-size: 11px;
+  margin-top: 5px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.managed-tab-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 10px;
+}
+
+.managed-tab-chip {
+  background: rgba(0, 0, 0, .18);
+  border-radius: 4px;
+  color: var(--google-grey-300);
+  font-family: monospace;
+  font-size: 10px;
+  padding: 4px 6px;
+}
+
+.managed-tab-navigation {
+  display: flex;
+  gap: 8px;
+  margin-top: 12px;
+  max-width: 620px;
+}
+
+.managed-tab-navigation-input {
+  flex: 1;
+  font-family: monospace;
+  font-size: 11px;
+}
+
+.managed-tab-actions {
+  align-items: center;
+  display: flex;
+  gap: 8px;
+  flex-shrink: 0;
+}
+
+.managed-tab-empty {
+  border: 1px dashed rgba(255, 255, 255, .28);
+  border-radius: 8px;
+  color: var(--google-grey-300);
+  font-size: 13px;
+  padding: 24px;
+  text-align: center;
+}
+
+.managed-tab-empty-title {
+  color: var(--google-grey-100);
+  font-size: 14px;
+  font-weight: 500;
+  margin-bottom: 6px;
+}
+
+@media (max-width: 700px) {
+  .managed-tabs-section {
+    margin: 12px;
+    padding: 18px;
+  }
+
+  .managed-tabs-create,
+  .managed-tab-row {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .managed-tab-actions {
+    justify-content: flex-end;
+  }
+}
