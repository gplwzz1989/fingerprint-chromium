+}
+
+bool ParseManagedTabProxyRules(const std::string& proxy_rules,
+                               net::ProxyConfig::ProxyRules* parsed_rules) {
+  if (proxy_rules.empty() || proxy_rules.size() > 2048 ||
+      proxy_rules.find_first_of(";,=") != std::string::npos) {
+    return proxy_rules.empty();
+  }
+
+  parsed_rules->ParseFromString(proxy_rules);
+  return parsed_rules->type == net::ProxyConfig::ProxyRules::Type::PROXY_LIST &&
+         parsed_rules->single_proxies.size() == 1;
+}
