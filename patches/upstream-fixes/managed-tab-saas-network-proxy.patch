+bool ManagedTabContext::IsValidNetworkProxy(const std::string& proxy_rules) {
+  net::ProxyConfig::ProxyRules parsed_rules;
+  return ParseManagedTabProxyRules(proxy_rules, &parsed_rules);
+}
+
+// static
+std::string ManagedTabContext::GetNetworkProxyRulesForId(
+    const std::string& id) {
+  auto it = ManagedTabProxyRules().find(id);
+  return it == ManagedTabProxyRules().end() ? std::string() : it->second;
+}
+
+// static
+void ManagedTabContext::ConfigureNetworkContextParams(
+    const content::StoragePartitionConfig& config,
+    network::mojom::NetworkContextParams* network_context_params) {
+  if (config.partition_domain() != kManagedTabPartitionDomain ||
+      config.partition_name().empty()) {
+    return;
+  }
+
+  const std::string proxy_rules =
+      GetNetworkProxyRulesForId(config.partition_name());
+  if (proxy_rules.empty()) {
+    return;
+  }
+
+  net::ProxyConfig::ProxyRules parsed_rules;
+  if (!ParseManagedTabProxyRules(proxy_rules, &parsed_rules)) {
+    return;
+  }
+
+  auto custom_proxy_config = network::mojom::CustomProxyConfig::New();
+  custom_proxy_config->rules = std::move(parsed_rules);
+  custom_proxy_config->should_override_existing_config = true;
+  custom_proxy_config->allow_non_idempotent_methods = true;
+  network_context_params->initial_custom_proxy_config =
+      std::move(custom_proxy_config);
+}
