+int ChromeContentBrowserClient::GetWorkerFingerprintHardwareConcurrency(
+    const content::StoragePartitionConfig& config) {
+  for (chrome::ManagedTabContext* tab : chrome::ManagedTabContext::GetAll()) {
+    if (tab->storage_partition_config() == config) {
+      return tab->fingerprint_hardware_concurrency();
+    }
+  }
+  return 0;
+}
