-  }
-
-  return browser;
+  // Managed browser mode keeps every native Tab in one parent window.
+  return nullptr;
 }
@@ -332,8 +332,5 @@ void BrowserTabStripModelDelegate::WillAddWebContents(
 }
 
 int BrowserTabStripModelDelegate::GetDragActions() const {
-  return TabStripModelDelegate::TAB_TEAROFF_ACTION |
