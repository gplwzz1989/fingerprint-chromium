+void ManagementUIHandler::HandleWriteManagedTabStorageSnapshot(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 3 || !args[1].is_string() || !args[2].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("存储写入参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& snapshot = args[2].GetDict();
+  if (!snapshot.FindList("cookies") || !snapshot.FindDict("local_storage")) {
+    RejectJavascriptCallback(args[0], base::Value("存储快照格式无效"));
+    return;
+  }
+
+  base::Value::Dict fingerprint;
+  if (const base::Value* fingerprint_value = snapshot.Find("fingerprint")) {
+    if (!fingerprint_value->is_dict()) {
+      RejectJavascriptCallback(args[0], base::Value("指纹配置格式无效"));
+      return;
+    }
+    const base::Value::Dict& input = fingerprint_value->GetDict();
+    const std::string* user_agent = input.FindString("user_agent");
+    const std::optional<int> hardware_concurrency =
+        input.FindInt("hardware_concurrency");
+    if (!user_agent || user_agent->size() > 512 ||
+        !hardware_concurrency || *hardware_concurrency < 0 ||
+        *hardware_concurrency > 64) {
+      RejectJavascriptCallback(args[0], base::Value("指纹配置格式无效"));
+      return;
+    }
+    fingerprint = input.Clone();
+  }
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context) {
+    RejectJavascriptCallback(args[0], base::Value("原生 Tab 不存在"));
+    return;
+  }
+
+  if (const std::string* storage_url = snapshot.FindString("storage_url")) {
+    const GURL snapshot_url(*storage_url);
+    if (!snapshot_url.is_valid() ||
+        url::Origin::Create(snapshot_url) !=
+            url::Origin::Create(context->current_url())) {
+      RejectJavascriptCallback(
+          args[0], base::Value("LocalStorage 所属来源与当前页面不一致，请先导航到对应网站"));
+      return;
+    }
+  }
+
+  context->WriteStorageSnapshot(
+      snapshot,
+      base::BindOnce(&ManagementUIHandler::OnManagedTabStorageSnapshotWritten,
+                     weak_factory_.GetWeakPtr(), args[0].Clone(),
+                     args[1].GetString(), std::move(fingerprint)));
+}
+
+void ManagementUIHandler::OnManagedTabStorageSnapshotWritten(
+    base::Value callback_id,
+    std::string tab_id,
+    base::Value::Dict fingerprint,
+    bool success,
+    std::string error) {
+  if (!success) {
+    RejectJavascriptCallback(callback_id, base::Value(std::move(error)));
+    return;
+  }
+
+  if (!fingerprint.empty()) {
+    ManagedTabContext* context = ManagedTabContext::FindById(tab_id);
+    const std::string* user_agent = fingerprint.FindString("user_agent");
+    const std::optional<int> hardware_concurrency =
+        fingerprint.FindInt("hardware_concurrency");
+    if (!context || !user_agent || !hardware_concurrency ||
+        !context->SetFingerprintUserAgent(*user_agent) ||
+        !context->SetFingerprintHardwareConcurrency(*hardware_concurrency)) {
+      RejectJavascriptCallback(callback_id, base::Value("指纹配置写入失败"));
+      return;
+    }
+  }
+
+  ResolveJavascriptCallback(callback_id, base::Value(true));
+}
 
 void ManagementUIHandler::HandleGetExtensions(const base::Value::List& args) {
