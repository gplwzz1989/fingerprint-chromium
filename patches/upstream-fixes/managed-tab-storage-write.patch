+void ManagedTabContext::WriteStorageSnapshot(
+    const base::Value::Dict& snapshot,
+    StorageWriteCallback callback) {
+  if (!web_contents()) {
+    std::move(callback).Run(false, "原生 Tab 不可用");
+    return;
+  }
+
+  const base::Value::List* cookies = snapshot.FindList("cookies");
+  const base::Value::Dict* local_storage =
+      snapshot.FindDict("local_storage");
+  if (!cookies || !local_storage || cookies->size() > 5000) {
+    std::move(callback).Run(false, "存储快照格式无效");
+    return;
+  }
+
+  std::string local_storage_json;
+  if (!base::JSONWriter::Write(*local_storage, &local_storage_json) ||
+      local_storage_json.size() > 10 * 1024 * 1024) {
+    std::move(callback).Run(false, "LocalStorage 数据过大或格式无效");
+    return;
+  }
+  for (const auto& entry : *local_storage) {
+    if (!entry.second.is_string() || entry.first.size() > 1024 ||
+        entry.second.GetString().size() > 1024 * 1024) {
+      std::move(callback).Run(false, "LocalStorage 数据格式无效");
+      return;
+    }
+  }
+
+  std::vector<std::unique_ptr<net::CanonicalCookie>> canonical_cookies;
+  canonical_cookies.reserve(cookies->size());
+  for (const base::Value& value : *cookies) {
+    const base::Value::Dict* cookie = value.GetIfDict();
+    const std::string* name = cookie ? cookie->FindString("name") : nullptr;
+    const std::string* cookie_value =
+        cookie ? cookie->FindString("value") : nullptr;
+    const std::string* domain =
+        cookie ? cookie->FindString("domain") : nullptr;
+    const std::string* path = cookie ? cookie->FindString("path") : nullptr;
+    const std::optional<bool> secure = cookie
+                                           ? cookie->FindBool("secure")
+                                           : std::nullopt;
+    const std::optional<bool> http_only = cookie
+                                              ? cookie->FindBool("http_only")
+                                              : std::nullopt;
+    if (!cookie || !name || !cookie_value || !domain || !path ||
+        !secure || !http_only || name->size() > 4096 ||
+        cookie_value->size() > 4096 || domain->empty() || path->empty()) {
+      std::move(callback).Run(false, "Cookie 数据格式无效");
+      return;
+    }
+
+    const std::string cookie_host =
+        domain->front() == '.' ? domain->substr(1) : *domain;
+    const GURL source_url(std::string(*secure ? "https://" : "http://") +
+                          cookie_host + "/");
+    if (!source_url.is_valid() || !source_url.has_host()) {
+      std::move(callback).Run(false, "Cookie 域名无效");
+      return;
+    }
+
+    int same_site_value =
+        static_cast<int>(net::CookieSameSite::UNSPECIFIED);
+    if (std::optional<int> value = cookie->FindInt("same_site")) {
+      same_site_value = *value;
+    }
+    if (same_site_value < -1 || same_site_value > 2) {
+      std::move(callback).Run(false, "Cookie SameSite 配置无效");
+      return;
+    }
+
+    int priority_value = net::COOKIE_PRIORITY_DEFAULT;
+    if (std::optional<int> value = cookie->FindInt("priority")) {
+      priority_value = *value;
+    }
+    if (priority_value < net::COOKIE_PRIORITY_LOW ||
+        priority_value > net::COOKIE_PRIORITY_HIGH) {
+      std::move(callback).Run(false, "Cookie 优先级配置无效");
+      return;
+    }
+
+    base::Time creation_time;
+    base::Time last_access_time;
+    base::Time expiry_time;
+    if (!GetCookieTime(*cookie, "creation", &creation_time) ||
+        !GetCookieTime(*cookie, "last_access", &last_access_time) ||
+        !GetCookieExpiry(*cookie, &expiry_time)) {
+      std::move(callback).Run(false, "Cookie 时间字段无效");
+      return;
+    }
+
+    std::optional<net::CookiePartitionKey> partition_key;
+    if (const base::Value::Dict* serialized_key =
+            cookie->FindDict("partition_key")) {
+      const std::string* top_level_site =
+          serialized_key->FindString("top_level_site");
+      const std::optional<bool> cross_site_ancestor =
+          serialized_key->FindBool("has_cross_site_ancestor");
+      if (!top_level_site || !cross_site_ancestor) {
+        std::move(callback).Run(false, "Cookie 分区键无效");
+        return;
+      }
+      auto parsed_key = net::CookiePartitionKey::FromUntrustedInput(
+          *top_level_site, *cross_site_ancestor);
+      if (!parsed_key.has_value()) {
+        std::move(callback).Run(false, "Cookie 分区键无效");
+        return;
+      }
+      partition_key = std::move(parsed_key.value());
+    }
+
+    net::CookieInclusionStatus status;
+    auto canonical_cookie = net::CanonicalCookie::CreateSanitizedCookie(
+        source_url, *name, *cookie_value, *domain, *path, creation_time,
+        expiry_time, last_access_time, *secure, *http_only,
+        static_cast<net::CookieSameSite>(same_site_value),
+        static_cast<net::CookiePriority>(priority_value),
+        std::move(partition_key), &status);
+    if (!canonical_cookie) {
+      std::move(callback).Run(false, "Cookie 数据无法写入");
+      return;
+    }
+    canonical_cookies.push_back(std::move(canonical_cookie));
+  }
+
+  content::RenderFrameHost* frame_host = web_contents()->GetPrimaryMainFrame();
+  if (!frame_host || !frame_host->IsRenderFrameLive()) {
+    std::move(callback).Run(false, "当前页面尚未准备好写入 LocalStorage");
+    return;
+  }
+
+  auto completion = std::make_shared<StorageWriteCompletion>(
+      std::move(callback));
+  content::StoragePartition* storage_partition =
+      web_contents()->GetBrowserContext()->GetStoragePartition(
+          storage_partition_config_);
+  auto* cookie_manager =
+      storage_partition->GetCookieManagerForBrowserProcess();
+  net::CookieOptions cookie_options;
+  cookie_options.set_include_httponly();
+  cookie_options.set_same_site_cookie_context(
+      net::CookieOptions::SameSiteCookieContext::MakeInclusiveForSet());
+  auto cookies_to_write = std::make_shared<
+      std::vector<std::unique_ptr<net::CanonicalCookie>>>(
+      std::move(canonical_cookies));
+  cookie_manager->DeleteCookies(
+      network::mojom::CookieDeletionFilter::New(),
+      base::BindOnce(&OnCookiesCleared, cookie_manager, cookies_to_write,
+                     cookie_options, completion));
+
+  const std::u16string local_storage_script = base::UTF8ToUTF16(
+      "(() => {"
+      "const snapshot = " +
+      local_storage_json +
+      "; localStorage.clear();"
+      "for (const [key, value] of Object.entries(snapshot)) "
+      "localStorage.setItem(key, value); return true;"
+      "})()");
+  frame_host->ExecuteJavaScriptInIsolatedWorld(
+      local_storage_script,
+      base::BindOnce(&OnLocalStorageWriteResult, completion),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  MaybeFinishStorageWrite(completion);
+}

