+struct StorageWriteCompletion {
+  explicit StorageWriteCompletion(
+      ManagedTabContext::StorageWriteCallback callback)
+      : callback(std::move(callback)) {}
+
+  ManagedTabContext::StorageWriteCallback callback;
+  bool cookies_succeeded = true;
+  bool cookies_finished = false;
+  bool local_storage_succeeded = false;
+  bool local_storage_finished = false;
+};
+
+void MaybeFinishStorageWrite(
+    const std::shared_ptr<StorageWriteCompletion>& completion) {
+  if (!completion->cookies_finished || !completion->local_storage_finished) {
+    return;
+  }
+
+  const bool success = completion->cookies_succeeded &&
+                       completion->local_storage_succeeded;
+  std::move(completion->callback)
+      .Run(success, success ? std::string() : "存储数据写入失败");
+}
+
+void OnCookieWriteResult(
+    const std::shared_ptr<StorageWriteCompletion>& completion,
+    const base::RepeatingClosure& done,
+    net::CookieAccessResult result) {
+  completion->cookies_succeeded &= result.status.IsInclude();
+  done.Run();
+}
+
+void WriteCanonicalCookies(
+    network::mojom::CookieManager* cookie_manager,
+    const std::shared_ptr<
+        std::vector<std::unique_ptr<net::CanonicalCookie>>>& cookies,
+    net::CookieOptions cookie_options,
+    const std::shared_ptr<StorageWriteCompletion>& completion) {
+  const base::RepeatingClosure cookies_done = base::BarrierClosure(
+      cookies->size(),
+      base::BindOnce(
+          [](const std::shared_ptr<StorageWriteCompletion>& completion) {
+            completion->cookies_finished = true;
+            MaybeFinishStorageWrite(completion);
+          },
+          completion));
+
+  for (const auto& cookie : *cookies) {
+    const std::string cookie_host = cookie->Domain().front() == '.'
+                                        ? cookie->Domain().substr(1)
+                                        : cookie->Domain();
+    const GURL source_url(
+        std::string(cookie->IsSecure() ? "https://" : "http://") +
+        cookie_host + "/");
+    cookie_manager->SetCanonicalCookie(
+        *cookie, source_url, cookie_options,
+        base::BindOnce(&OnCookieWriteResult, completion, cookies_done));
+  }
+  if (cookies->empty()) {
+    completion->cookies_finished = true;
+    MaybeFinishStorageWrite(completion);
+  }
+}
+
+void OnCookiesCleared(
+    network::mojom::CookieManager* cookie_manager,
+    const std::shared_ptr<
+        std::vector<std::unique_ptr<net::CanonicalCookie>>>& cookies,
+    net::CookieOptions cookie_options,
+    const std::shared_ptr<StorageWriteCompletion>& completion,
+    uint32_t) {
+  WriteCanonicalCookies(cookie_manager, cookies, std::move(cookie_options),
+                        completion);
+}
+
+void OnLocalStorageWriteResult(
+    const std::shared_ptr<StorageWriteCompletion>& completion,
+    base::Value result) {
+  completion->local_storage_succeeded =
+      result.is_bool() && result.GetBool();
+  completion->local_storage_finished = true;
+  MaybeFinishStorageWrite(completion);
+}
+
+bool GetCookieTime(const base::Value::Dict& cookie,
+                   const char* key,
+                   base::Time* result) {
+  const base::Value* value = cookie.Find(key);
+  if (!value) {
+    *result = base::Time::Now();
+    return true;
+  }
+
+  std::optional<double> milliseconds = value->GetIfDouble();
+  if (!milliseconds) {
+    if (std::optional<int> integer = value->GetIfInt()) {
+      milliseconds = *integer;
+    }
+  }
+  if (!milliseconds || !std::isfinite(*milliseconds)) {
+    return false;
+  }
+
+  *result = base::Time::FromJsTime(*milliseconds);
+  return true;
+}
+
+bool GetCookieExpiry(const base::Value::Dict& cookie, base::Time* result) {
+  const base::Value* value = cookie.Find("expires");
+  if (!value || value->is_none()) {
+    *result = base::Time();
+    return true;
+  }
+
+  std::optional<double> milliseconds = value->GetIfDouble();
+  if (!milliseconds) {
+    if (std::optional<int> integer = value->GetIfInt()) {
+      milliseconds = *integer;
+    }
+  }
+  if (!milliseconds || !std::isfinite(*milliseconds)) {
+    return false;
+  }
+
+  *result = base::Time::FromJsTime(*milliseconds);
+  return true;
+}
 
