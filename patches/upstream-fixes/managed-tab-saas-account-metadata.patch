@@ -424,6 +424,43 @@ export class FingerprintManagerUiElement extends CrLitElement {
     }
   }
 
+  protected async onSaasUpdateAccount_(source: Event, account: SaasAccount) {
+    if (!this.saasClient_ || this.saasBusy_) {
+      return;
+    }
+    const row = (source.currentTarget as HTMLElement).closest(
+        '.saas-account-row');
+    const nameInput =
+        row?.querySelector<HTMLInputElement>('.saas-account-name-input');
+    const labelsInput =
+        row?.querySelector<HTMLInputElement>('.saas-account-labels-input');
+    const name = nameInput?.value.trim() || '';
+    const labels = (labelsInput?.value || '').split(',').map(label =>
+        label.trim()).filter(label => label.length > 0);
+    if (!name) {
+      this.saasError_ = '账号名称不能为空';
+      return;
+    }
+    if (labels.length > 50 || labels.some(label => label.length > 64)) {
+      this.saasError_ = '账号标签数量或长度超出限制';
+      return;
+    }
+
+    this.saasBusy_ = true;
+    this.saasError_ = '';
+    try {
+      const updated = await this.saasClient_.updateAccount(
+          account.account_id, name, labels);
+      this.saasAccounts_ = this.saasAccounts_.map(item =>
+          item.account_id === updated.account_id ? updated : item);
+      this.saasError_ = `账号 ${updated.account_id} 已更新`;
+    } catch (error) {
+      this.saasError_ = getSaasErrorMessage(error);
+    } finally {
+      this.saasBusy_ = false;
+    }
+  }
+
