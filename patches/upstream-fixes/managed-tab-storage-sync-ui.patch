diff --git a/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
--- a/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
+++ b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
@@ -210,5 +210,47 @@ export class FingerprintManagerUiElement extends
     this.managedTabError_ = '存储快照已下载';
   }
+
+  protected onImportStorageSnapshot_(id: string) {
+    const input = document.createElement('input');
+    input.type = 'file';
+    input.accept = '.json,application/json';
+    input.addEventListener('change', () => {
+      const file = input.files?.[0];
+      if (!file) {
+        return;
+      }
+
+      file.text().then(text => {
+        let snapshot: ManagedTabStorageSnapshot;
+        try {
+          snapshot = JSON.parse(text) as ManagedTabStorageSnapshot;
+        } catch {
+          this.managedTabError_ = '导入文件不是有效的 JSON';
+          return;
+        }
+
+        if (!snapshot || !Array.isArray(snapshot.cookies) ||
+            !snapshot.local_storage ||
+            typeof snapshot.local_storage !== 'object') {
+          this.managedTabError_ = '导入文件不是有效的存储快照';
+          return;
+        }
+
+        this.managedTabError_ = '';
+        this.browserProxy_.writeManagedTabStorageSnapshot(id, snapshot).then(
+            () => {
+              this.managedTabError_ = '存储与指纹配置已写入该 Tab';
+              this.getManagedTabs_();
+            },
+            () => {
+              this.managedTabError_ = '写入存储快照失败，请检查页面状态后重试';
+            });
+      }, () => {
+        this.managedTabError_ = '读取导入文件失败，请重试';
+      });
+    });
+    input.click();
+  }
 
   protected getTabIndex_(index: number): string {
     return String(index + 1).padStart(2, '0');
