 ManagedTabContext::~ManagedTabContext() = default;
+
+bool ManagedTabContext::Activate() {
+  if (!web_contents()) {
+    return false;
+  }
+
+  Browser* browser = chrome::FindBrowserWithTab(web_contents());
+  if (!browser) {
+    return false;
+  }
+
+  const int index =
+      browser->tab_strip_model()->GetIndexOfWebContents(web_contents());
+  if (index < 0) {
+    return false;
+  }
+
+  browser->tab_strip_model()->ActivateTabAt(index);
+  return true;
+}
+
+bool ManagedTabContext::Close() {
+  if (!web_contents()) {
+    return false;
+  }
+
+  Browser* browser = chrome::FindBrowserWithTab(web_contents());
+  if (!browser) {
+    return false;
+  }
+
+  const int index =
+      browser->tab_strip_model()->GetIndexOfWebContents(web_contents());
+  if (index < 0) {
+    return false;
+  }
+
+  browser->tab_strip_model()->CloseWebContentsAt(
+      index, TabCloseTypes::CLOSE_USER_GESTURE);
+  return true;
+}
 
