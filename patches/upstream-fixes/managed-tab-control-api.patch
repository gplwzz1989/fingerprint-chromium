+bool ManagedTabContext::NavigateTo(const GURL& url) {
+  if (!web_contents() || !url.is_valid()) {
+    return false;
+  }
+
+  web_contents()->GetController().LoadURL(
+      url, content::Referrer(), ui::PAGE_TRANSITION_TYPED, std::string());
+  return true;
+}
