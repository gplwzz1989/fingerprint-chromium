diff --git a/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
--- a/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
+++ b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
@@ -498,6 +498,38 @@
   protected async onSaasWorkspaceChange_(event: Event) {
     const select = event.currentTarget as HTMLSelectElement;
     this.saasWorkspaceId_ = select.value;
     this.saasInviteToken_ = '';
     this.saasSnapshotConflict_ = null;
     this.saasAccountMembers_ = null;
     this.saasAccountMembersAccountId_ = '';
     await this.loadSaasAccounts_();
     await this.loadSaasMembers_();
   }
+
+  protected async onSaasCreateWorkspace_() {
+    if (!this.saasClient_ || this.saasBusy_) {
+      return;
+    }
+    const name = window.prompt('请输入新的工作区名称')?.trim() || '';
+    if (!name) {
+      this.saasError_ = '工作区名称不能为空';
+      return;
+    }
+    this.saasBusy_ = true;
+    this.saasError_ = '';
+    try {
+      const workspace = await this.saasClient_.createWorkspace(name);
+      this.saasWorkspaces_ = [...this.saasWorkspaces_, workspace];
+      this.saasWorkspaceId_ = workspace.workspace_id;
+      this.saasInviteToken_ = '';
+      this.saasSnapshotConflict_ = null;
+      this.saasAccountMembers_ = null;
+      this.saasAccountMembersAccountId_ = '';
+      await this.loadSaasAccounts_();
+      await this.loadSaasMembers_();
+      this.saasError_ = `工作区 ${workspace.name} 已创建`;
+    } catch (error) {
+      this.saasError_ = getSaasErrorMessage(error);
+    } finally {
+      this.saasBusy_ = false;
+    }
+  }
 
   protected async onSaasRefresh_() {
