@@ -0,0 +1,75 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface ManagedTabState {
+  id: string;
+  url: string;
+  title: string;
+  load_progress: number;
+  storage_partition: string;
+  storage_partition_persistent: boolean;
+  hardware_concurrency: number;
+  user_agent: string;
+}
+
+export interface ManagedTabCookie {
+  name: string;
+  value: string;
+  domain: string;
+  path: string;
+  secure: boolean;
+  http_only: boolean;
+}
+
+export interface ManagedTabStorageSnapshot {
+  cookies: ManagedTabCookie[];
+  local_storage: {[key: string]: string};
+}
+
+export interface FingerprintManagerBrowserProxy {
+  getManagedTabs(): Promise<ManagedTabState[]>;
+  createManagedTab(url?: string): Promise<ManagedTabState>;
+  activateManagedTab(id: string): Promise<boolean>;
+  navigateManagedTab(id: string, url: string): Promise<boolean>;
+  closeManagedTab(id: string): Promise<boolean>;
+  getManagedTabStorageSnapshot(
+      id: string): Promise<ManagedTabStorageSnapshot>;
+}
+
+export class FingerprintManagerBrowserProxyImpl
+    implements FingerprintManagerBrowserProxy {
+  getManagedTabs() {
+    return sendWithPromise('getManagedTabs');
+  }
+
+  createManagedTab(url?: string) {
+    return url === undefined ? sendWithPromise('createManagedTab') :
+                               sendWithPromise('createManagedTab', url);
+  }
+
+  activateManagedTab(id: string) {
+    return sendWithPromise('activateManagedTab', id);
+  }
+
+  navigateManagedTab(id: string, url: string) {
+    return sendWithPromise('navigateManagedTab', id, url);
+  }
+
+  closeManagedTab(id: string) {
+    return sendWithPromise('closeManagedTab', id);
+  }
+
+  getManagedTabStorageSnapshot(id: string) {
+    return sendWithPromise('getManagedTabStorageSnapshot', id);
+  }
+
+  static getInstance(): FingerprintManagerBrowserProxy {
+    return instance || (instance = new FingerprintManagerBrowserProxyImpl());
+  }
+}
+
+let instance: FingerprintManagerBrowserProxy|null = null;
+
diff --git a/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/fingerprint_manager/fingerprint_manager_ui.ts
@@ -0,0 +1,200 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {
+  FingerprintManagerBrowserProxy,
+  ManagedTabState,
+  ManagedTabStorageSnapshot,
+} from './fingerprint_manager_browser_proxy.js';
+import {FingerprintManagerBrowserProxyImpl} from
+    './fingerprint_manager_browser_proxy.js';
+import {getCss} from './fingerprint_manager_ui.css.js';
+import {getHtml} from './fingerprint_manager_ui.html.js';
+
+export class FingerprintManagerUiElement extends CrLitElement {
+  static get is() {
+    return 'fingerprint-manager-ui';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  static override get properties() {
+    return {
+      managedTabs_: {type: Array},
+      loading_: {type: Boolean},
+      managedTabError_: {type: String},
+      storageSnapshots_: {type: Object},
+      storageLoadingId_: {type: String},
+    };
+  }
+
+  protected accessor managedTabs_: ManagedTabState[] = [];
+  protected accessor loading_: boolean = true;
+  protected accessor managedTabError_: string = '';
+  protected accessor storageSnapshots_: {
+    [id: string]: ManagedTabStorageSnapshot,
+  } = {};
+  protected accessor storageLoadingId_: string = '';
+
+  private browserProxy_: FingerprintManagerBrowserProxy =
+      FingerprintManagerBrowserProxyImpl.getInstance();
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.getManagedTabs_();
+  }
+
+  protected onRefresh_() {
+    this.getManagedTabs_();
+  }
+
+  private getManagedTabs_() {
+    this.loading_ = true;
+    this.browserProxy_.getManagedTabs().then(
+        managedTabs => {
+          this.managedTabs_ = managedTabs;
+          this.storageSnapshots_ = {};
+          this.loading_ = false;
+          this.managedTabError_ = '';
+        },
+        () => {
+          this.loading_ = false;
+          this.managedTabError_ = '无法读取原生 Tab 状态，请重试';
+        });
+  }
+
+  private runManagedTabAction_(action: Promise<unknown>) {
+    this.managedTabError_ = '';
+    action.then(
+        result => {
+          if (result === false) {
+            this.managedTabError_ = '原生 Tab 操作失败，请重试';
+            return;
+          }
+          this.getManagedTabs_();
+        },
+        () => {
+          this.managedTabError_ = '原生 Tab 操作失败，请重试';
+        });
+  }
+
+  protected onCreateManagedTab_() {
+    const input =
+        this.shadowRoot.querySelector<HTMLInputElement>('#managedTabUrl');
+    const url = input?.value.trim();
+    this.runManagedTabAction_(this.browserProxy_.createManagedTab(url ||
+                                                                  undefined));
+    if (input) {
+      input.value = '';
+    }
+  }
+
+  protected onCreateManagedTabKeydown_(event: KeyboardEvent) {
+    if (event.key === 'Enter') {
+      event.preventDefault();
+      this.onCreateManagedTab_();
+    }
+  }
+
+  protected onActivateManagedTab_(id: string) {
+    this.runManagedTabAction_(this.browserProxy_.activateManagedTab(id));
+  }
+
+  protected onCloseManagedTab_(id: string) {
+    this.runManagedTabAction_(this.browserProxy_.closeManagedTab(id));
+  }
+
+  protected onManagedTabNavigate_(source: Event, id: string) {
+    const element = source.currentTarget as HTMLElement;
+    const input = element.matches('input') ? element as HTMLInputElement :
+                                               element.parentElement?.querySelector<
+                                                   HTMLInputElement>(
+                                                   '.tab-navigation-input');
+    const url = input?.value.trim();
+    if (!url) {
+      this.managedTabError_ = '请输入要打开的网址';
+      return;
+    }
+    this.runManagedTabAction_(this.browserProxy_.navigateManagedTab(id, url));
+  }
+
+  protected onManagedTabNavigateKeydown_(event: KeyboardEvent, id: string) {
+    if (event.key === 'Enter') {
+      event.preventDefault();
+      this.onManagedTabNavigate_(event, id);
+    }
+  }
+
+  protected onStorageSnapshot_(id: string) {
+    if (this.storageSnapshots_[id]) {
+      const snapshots = {...this.storageSnapshots_};
+      delete snapshots[id];
+      this.storageSnapshots_ = snapshots;
+      return;
+    }
+
+    this.storageLoadingId_ = id;
+    this.managedTabError_ = '';
+    this.browserProxy_.getManagedTabStorageSnapshot(id).then(
+        snapshot => {
+          this.storageSnapshots_ = {...this.storageSnapshots_, [id]: snapshot};
+          this.storageLoadingId_ = '';
+        },
+        () => {
+          this.storageLoadingId_ = '';
+          this.managedTabError_ = '无法读取该 Tab 的存储数据，请重试';
+        });
+  }
+
+  protected onCopyStorageSnapshot_(id: string) {
+    const snapshot = this.storageSnapshots_[id];
+    if (!snapshot) {
+      return;
+    }
+
+    navigator.clipboard.writeText(JSON.stringify(snapshot, null, 2)).then(
+        () => {
+          this.managedTabError_ = '存储快照已复制到剪贴板';
+        },
+        () => {
+          this.managedTabError_ = '复制存储快照失败，请重试';
+        });
+  }
+
+  protected getTabIndex_(index: number): string {
+    return String(index + 1).padStart(2, '0');
+  }
+
+  protected getLoadLabel_(tab: ManagedTabState): string {
+    if (tab.load_progress >= 1) {
+      return '就绪';
+    }
+    if (tab.load_progress <= 0) {
+      return '等待加载';
+    }
+    return `${Math.round(tab.load_progress * 100)}%`;
+  }
+
+  protected getStorageKeyCount_(snapshot: ManagedTabStorageSnapshot): number {
+    return Object.keys(snapshot.local_storage).length;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'fingerprint-manager-ui': FingerprintManagerUiElement;
+  }
+}
+
+customElements.define(
+    FingerprintManagerUiElement.is, FingerprintManagerUiElement);
+
