+        </div>
+
+        <div class="message-bar" ?hidden="${!this.managedTabError_}">
+          ${this.managedTabError_}
+        </div>
+
+        ${this.loading_ ? html`
+          <div class="loading-state">
+            <span class="loading-line"></span>
+            正在读取环境状态…
+          </div>
+        ` : this.managedTabs_.length ? html`
+          <div class="tab-list">
+            ${this.managedTabs_.map((tab, index) => html`
+              <article class="tab-card">
+                <div class="tab-card-main">
+                  <div class="tab-number">${this.getTabIndex_(index)}</div>
+                  <div class="tab-identity">
+                    <div class="tab-title-line">
+                      <h4>${tab.title || '未命名环境'}</h4>
+                      <span class="load-state">${this.getLoadLabel_(tab)}</span>
+                    </div>
+                    <div class="tab-url" title="${tab.url}">
+                      ${tab.url || 'about:blank'}
+                    </div>
+                    <div class="tab-chips">
+                      <span class="tab-chip tab-chip-accent">${tab.id}</span>
+                      <span class="tab-chip">
+                        ${tab.storage_partition_persistent ? '持久化分区' : '临时分区'}
+                      </span>
+                      <span class="tab-chip">
+                        ${tab.hardware_concurrency > 0 ?
+                            `${tab.hardware_concurrency} 核并发` : '默认并发'}
+                      </span>
+                      ${tab.user_agent ? html`
+                        <span class="tab-chip">自定义 UA</span>
+                      ` : ''}
+                    </div>
+                  </div>
+                  <div class="tab-card-actions">
+                    <button class="text-button" type="button"
+                        @click="${() => this.onActivateManagedTab_(tab.id)}">
+                      切换
+                    </button>
+                    <button class="text-button text-button-danger" type="button"
+                        @click="${() => this.onCloseManagedTab_(tab.id)}">
+                      关闭
+                    </button>
+                  </div>
+                </div>
+
+                <div class="tab-card-tools">
+                  <div class="tab-navigation">
+                    <span class="tool-label">导航</span>
+                    <input class="tab-navigation-input" type="url"
+                        .value="${tab.url}"
+                        aria-label="导航地址"
+                        @keydown="${(event: KeyboardEvent) =>
+                            this.onManagedTabNavigateKeydown_(event, tab.id)}">
+                    <button class="tool-button" type="button"
+                        @click="${(event: Event) =>
+                            this.onManagedTabNavigate_(event, tab.id)}">
+                      执行
+                    </button>
+                  </div>
+                  <button class="storage-button" type="button"
+                      ?disabled="${this.storageLoadingId_ === tab.id}"
+                      @click="${() => this.onStorageSnapshot_(tab.id)}">
+                    ${this.storageLoadingId_ === tab.id ? '读取中…' :
+                        this.storageSnapshots_[tab.id] ? '收起存储' : '查看存储'}
+                  </button>
+                </div>
+
+                ${this.storageSnapshots_[tab.id] ? html`
+                  <div class="storage-panel">
+                    <div class="storage-heading">
+                      <div>
+                        <div class="section-kicker">STORAGE SNAPSHOT</div>
+                        <strong>
+                          ${this.storageSnapshots_[tab.id]!.cookies.length} Cookie ·
+                          ${this.getStorageKeyCount_(this.storageSnapshots_[tab.id]!)} LocalStorage
+                        </strong>
+                      </div>
+                      <button class="tool-button" type="button"
+                          @click="${() => this.onCopyStorageSnapshot_(tab.id)}">
+                        复制 JSON
+                      </button>
+                    </div>
+                    <div class="storage-columns">
+                      <div class="storage-column">
+                        <h5>Cookies</h5>
+                        ${this.storageSnapshots_[tab.id]!.cookies.length ?
+                            this.storageSnapshots_[tab.id]!.cookies.map(cookie => html`
+                          <div class="storage-entry">
+                            <code>${cookie.name}</code>
+                            <span title="${cookie.value}">${cookie.value}</span>
+                            <small>${cookie.domain}</small>
+                          </div>
+                        `) : html`
+                          <div class="storage-empty">没有 Cookie</div>
+                        `}
+                      </div>
+                      <div class="storage-column">
+                        <h5>LocalStorage</h5>
+                        ${this.getStorageKeyCount_(this.storageSnapshots_[tab.id]!) ?
+                            Object.entries(
+                                this.storageSnapshots_[tab.id]!.local_storage)
+                                .map(([key, value]) => html`
+                          <div class="storage-entry">
+                            <code>${key}</code>
+                            <span title="${value}">${value}</span>
+                          </div>
+                        `) : html`
+                          <div class="storage-empty">没有 LocalStorage 数据</div>
+                        `}
+                      </div>
+                    </div>
+                  </div>
+                ` : ''}
+              </article>
+            `)}
+          </div>
+        ` : html`
+          <div class="empty-state">
+            <div class="empty-orbit">00</div>
+            <h4>还没有原生 Tab 环境</h4>
+            <p>输入一个网址，建立第一个独立账号空间。</p>
+          </div>
+        `}
+      </section>
+    </main>
+  </div>
+</div>`;
+  // clang-format on
+}
+
