+        catch (RuntimeException error) {
+            picker = null;
+            result.completeExceptionally(SaasFilePolicy.error("无法打开系统目录选择器"));
+            return result;
+        }
+        if (!shown) { picker = null; result.completeExceptionally(SaasFilePolicy.error("无法打开系统目录选择器")); }
+        return result;
+    }
+
+    public void revoke() {
