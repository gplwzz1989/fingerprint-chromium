+        }
+        Entry metadata(Uri uri) throws Exception {
+            check();
+            try (Cursor cursor = resolver.query(uri, COLUMNS, null, null, null)) {
+                if (cursor == null || !cursor.moveToFirst()) throw SaasFilePolicy.error("无法读取文件信息");
