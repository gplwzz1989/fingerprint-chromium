+            }
+        }
+        SaasBridgeDispatcher.RequestAuthority streamAuthority() {
+            return new SaasBridgeDispatcher.RequestAuthority() {
+                public boolean isActive() { return false; }
+                public boolean isActiveInBackground() { check(); return true; }
+            };
+        }
