+
+bool FilterOrdinaryHistory(
+    std::vector<TabAndroid*>* tabs,
+    std::vector<WebContentsStateByteBuffer>* states,
+    std::vector<std::optional<tab_groups::TabGroupId>>* groups = nullptr) {
+  if (tabs->size() != states->size() ||
+      (groups && groups->size() != tabs->size())) return false;
+  for (size_t i = tabs->size(); i > 0; --i) {
+    if (!ExcludeFromOrdinaryHistory((*tabs)[i - 1], (*states)[i - 1])) continue;
+    tabs->erase(tabs->begin() + (i - 1));
+    states->erase(states->begin() + (i - 1));
+    if (groups) groups->erase(groups->begin() + (i - 1));
+  }
+  return !tabs->empty();
+}
 
