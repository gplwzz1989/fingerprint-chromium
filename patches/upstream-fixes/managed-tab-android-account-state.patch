+#ifndef CHROME_BROWSER_UI_ANDROID_TAB_MODEL_SAAS_ACCOUNT_STATE_H_
+#define CHROME_BROWSER_UI_ANDROID_TAB_MODEL_SAAS_ACCOUNT_STATE_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
