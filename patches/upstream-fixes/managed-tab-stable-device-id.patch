+const kSaasDeviceIdStorageKey = 'fingerprint-manager.saas-device-id';
+
+function getSaasDeviceId(): string {
+  const uuidPattern =
+      /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+  try {
+    const savedDeviceId = window.localStorage.getItem(kSaasDeviceIdStorageKey);
+    if (savedDeviceId && uuidPattern.test(savedDeviceId)) {
+      return savedDeviceId;
+    }
+    const deviceId = crypto.randomUUID();
+    window.localStorage.setItem(kSaasDeviceIdStorageKey, deviceId);
+    return deviceId;
+  } catch {
+    return crypto.randomUUID();
+  }
+}
