+std::optional<std::string> ExtractUserAgentToken(
+    const std::string& user_agent,
+    std::string_view token) {
+  const size_t token_position = user_agent.find(token);
+  if (token_position == std::string::npos) {
+    return std::nullopt;
+  }
+
+  const size_t version_start = token_position + token.size();
+  const size_t version_end = user_agent.find_first_of(" ;)", version_start);
+  const std::string version = user_agent.substr(
+      version_start, version_end == std::string::npos
+                        ? std::string::npos
+                        : version_end - version_start);
+  return version.empty() ? std::nullopt : std::make_optional(version);
+}
+
+std::string UserAgentMajorVersion(const std::string& version) {
+  const size_t separator = version.find('.');
+  return separator == std::string::npos ? version : version.substr(0, separator);
+}
+
+std::optional<std::string> ExtractPlatformVersion(
+    const std::string& user_agent,
+    std::string_view token,
+    bool replace_underscores) {
+  std::optional<std::string> version =
+      ExtractUserAgentToken(user_agent, token);
+  if (version && replace_underscores) {
+    for (char& character : *version) {
+      if (character == '_') {
+        character = '.';
+      }
+    }
+  }
+  return version;
+}
+
+std::optional<blink::UserAgentMetadata> BuildManagedTabUserAgentMetadata(
+    const std::string& user_agent) {
+  std::optional<std::string> chromium_version =
+      ExtractUserAgentToken(user_agent, "Chrome/");
+  if (!chromium_version) {
+    return std::nullopt;
+  }
+
+  blink::UserAgentMetadata metadata;
+  const std::string chromium_major = UserAgentMajorVersion(*chromium_version);
+  metadata.brand_version_list.push_back({"Chromium", chromium_major});
+  metadata.brand_full_version_list.push_back({"Chromium", *chromium_version});
+  metadata.full_version = *chromium_version;
+
+  std::optional<std::string> edge_version =
+      ExtractUserAgentToken(user_agent, "Edg/");
+  std::optional<std::string> opera_version =
+      ExtractUserAgentToken(user_agent, "OPR/");
+  std::optional<std::string> vivaldi_version =
+      ExtractUserAgentToken(user_agent, "Vivaldi/");
+  if (edge_version) {
+    metadata.brand_version_list.push_back(
+        {ungoogled::fingerprint::kEdgeDisplayName,
+         UserAgentMajorVersion(*edge_version)});
+    metadata.brand_full_version_list.push_back(
+        {ungoogled::fingerprint::kEdgeDisplayName, *edge_version});
+  } else if (opera_version) {
+    metadata.brand_version_list.push_back(
+        {ungoogled::fingerprint::kOperaDisplayName,
+         UserAgentMajorVersion(*opera_version)});
+    metadata.brand_full_version_list.push_back(
+        {ungoogled::fingerprint::kOperaDisplayName, *opera_version});
+  } else if (vivaldi_version) {
+    metadata.brand_version_list.push_back(
+        {ungoogled::fingerprint::kVivaldiDisplayName,
+         UserAgentMajorVersion(*vivaldi_version)});
+    metadata.brand_full_version_list.push_back(
+        {ungoogled::fingerprint::kVivaldiDisplayName, *vivaldi_version});
+  } else {
+    metadata.brand_version_list.push_back(
+        {ungoogled::fingerprint::kChromeDisplayName, chromium_major});
+    metadata.brand_full_version_list.push_back(
+        {ungoogled::fingerprint::kChromeDisplayName, *chromium_version});
+  }
+
+  metadata.mobile = user_agent.find("Mobile") != std::string::npos ||
+                    user_agent.find("Android") != std::string::npos ||
+                    user_agent.find("iPhone") != std::string::npos ||
+                    user_agent.find("iPad") != std::string::npos;
+  if (user_agent.find("Windows NT ") != std::string::npos) {
+    metadata.platform = ungoogled::fingerprint::kWindowsPlatform;
+    metadata.platform_version =
+        ExtractPlatformVersion(user_agent, "Windows NT ", false).value_or("");
+    metadata.architecture = ungoogled::fingerprint::kX86Architecture;
+    metadata.bitness = user_agent.find("Win64") != std::string::npos ||
+                              user_agent.find("x64") != std::string::npos
+                          ? "64"
+                          : "32";
+  } else if (user_agent.find("Android") != std::string::npos) {
+    metadata.platform = "Android";
+    metadata.platform_version =
+        ExtractPlatformVersion(user_agent, "Android ", false).value_or("");
+    metadata.architecture = user_agent.find("arm64") != std::string::npos
+                                ? "arm"
+                                : ungoogled::fingerprint::kX86Architecture;
+    metadata.bitness = user_agent.find("arm64") != std::string::npos
+                          ? "64"
+                          : "32";
+  } else if (user_agent.find("Mac OS X ") != std::string::npos) {
+    metadata.platform = ungoogled::fingerprint::kMacOSPlatform;
+    metadata.platform_version = ExtractPlatformVersion(
+        user_agent, "Mac OS X ", true).value_or("");
+    metadata.architecture = user_agent.find("Intel") != std::string::npos
+                                ? ungoogled::fingerprint::kX86Architecture
+                                : ungoogled::fingerprint::kArmArchitecture;
+    metadata.bitness = "64";
+  } else if (user_agent.find("Linux") != std::string::npos) {
+    metadata.platform = ungoogled::fingerprint::kLinuxPlatform;
+    metadata.architecture = user_agent.find("aarch64") != std::string::npos
+                                ? ungoogled::fingerprint::kArmArchitecture
+                                : ungoogled::fingerprint::kX86Architecture;
+    metadata.bitness = user_agent.find("x86_64") != std::string::npos ||
+                              user_agent.find("aarch64") != std::string::npos
+                          ? "64"
+                          : "32";
+  }
+  metadata.form_factors.push_back(metadata.mobile ? blink::kMobileFormFactor
+                                                  : blink::kDesktopFormFactor);
+  return metadata;
+}
