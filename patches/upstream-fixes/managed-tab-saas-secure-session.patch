+bool IsAllowedSaasBaseUrl(const std::string& value) {
+  const GURL url(value);
+  if (!url.is_valid() || url.has_username() || url.has_password() ||
+      url.host().empty()) {
+    return false;
+  }
+  if (url.SchemeIs("https")) {
+    return true;
+  }
+  return url.SchemeIs("http") &&
+         (url.host() == "localhost" || url.host() == "127.0.0.1" ||
+          url.host() == "[::1]");
+}
+
+bool IsValidSaasSessionField(const std::string* value) {
+  return value && !value->empty() &&
+         value->size() <= kSaasSessionMaxFieldLength;
+}
 
