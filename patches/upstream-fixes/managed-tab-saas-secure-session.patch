+void ManagementUIHandler::HandleGetSaasSession(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+
+  Profile* profile = Profile::FromWebUI(web_ui());
+  const base::Value::Dict& saved =
+      profile->GetPrefs()->GetDict(prefs::kFingerprintManagerSaasSession);
+  const std::string* base_url = saved.FindString(kSaasSessionBaseUrlKey);
+  const std::string* email = saved.FindString(kSaasSessionEmailKey);
+  const std::string* device_id = saved.FindString(kSaasSessionDeviceIdKey);
+  const std::string* encoded_token =
+      saved.FindString(kSaasSessionRefreshTokenKey);
+
+  std::string encrypted_token;
+  std::string refresh_token;
+  if (!IsAllowedSaasBaseUrl(base_url ? *base_url : std::string()) ||
+      !IsValidSaasSessionField(email) ||
+      !IsValidSaasSessionField(device_id) ||
+      !IsValidSaasSessionField(encoded_token) ||
+      !base::Base64Decode(*encoded_token, &encrypted_token) ||
+      !OSCrypt::DecryptString(encrypted_token, &refresh_token) ||
+      !IsValidSaasSessionField(&refresh_token)) {
+    profile->GetPrefs()->ClearPref(prefs::kFingerprintManagerSaasSession);
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+
+  base::Value::Dict result;
+  result.Set(kSaasSessionBaseUrlKey, *base_url);
+  result.Set(kSaasSessionEmailKey, *email);
+  result.Set(kSaasSessionDeviceIdKey, *device_id);
+  result.Set(kSaasSessionRefreshTokenKey, std::move(refresh_token));
+  ResolveJavascriptCallback(args[0], std::move(result));
+}
+
+void ManagementUIHandler::HandleSetSaasSession(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_dict()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("SaaS 会话参数无效"));
+    }
+    return;
+  }
+
+  const base::Value::Dict& input = args[1].GetDict();
+  const std::string* base_url = input.FindString(kSaasSessionBaseUrlKey);
+  const std::string* email = input.FindString(kSaasSessionEmailKey);
+  const std::string* device_id = input.FindString(kSaasSessionDeviceIdKey);
+  const std::string* refresh_token =
+      input.FindString(kSaasSessionRefreshTokenKey);
+  if (!IsAllowedSaasBaseUrl(base_url ? *base_url : std::string()) ||
+      !IsValidSaasSessionField(email) ||
+      !IsValidSaasSessionField(device_id) ||
+      !IsValidSaasSessionField(refresh_token)) {
+    RejectJavascriptCallback(args[0], base::Value("SaaS 会话信息无效"));
+    return;
+  }
+
+  std::string encrypted_token;
+  if (!OSCrypt::EncryptString(*refresh_token, &encrypted_token)) {
+    RejectJavascriptCallback(args[0], base::Value("无法安全保存 SaaS 会话"));
+    return;
+  }
+
+  base::Value::Dict saved;
+  saved.Set(kSaasSessionBaseUrlKey, *base_url);
+  saved.Set(kSaasSessionEmailKey, *email);
+  saved.Set(kSaasSessionDeviceIdKey, *device_id);
+  saved.Set(kSaasSessionRefreshTokenKey, base::Base64Encode(encrypted_token));
+  Profile::FromWebUI(web_ui())->GetPrefs()->SetDict(
+      prefs::kFingerprintManagerSaasSession, std::move(saved));
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+void ManagementUIHandler::HandleClearSaasSession(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+  Profile::FromWebUI(web_ui())->GetPrefs()->ClearPref(
+      prefs::kFingerprintManagerSaasSession);
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
