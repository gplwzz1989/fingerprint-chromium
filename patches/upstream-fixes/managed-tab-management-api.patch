+void ManagementUIHandler::HandleGetManagedTabs(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], ManagedTabContext::GetAllState());
+}
+
+void ManagementUIHandler::HandleCreateManagedTab(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+
+  GURL url;
+  if (args.size() > 1) {
+    if (!args[1].is_string()) {
+      RejectJavascriptCallback(args[0], base::Value("URL 参数无效"));
+      return;
+    }
+    url = GURL(args[1].GetString());
+    if (!url.is_empty() && !url.is_valid()) {
+      RejectJavascriptCallback(args[0], base::Value("URL 参数无效"));
+      return;
+    }
+  }
+
+  Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+  ManagedTabContext* context =
+      ManagedTabContext::CreateNewTab(browser, url);
+  if (!context) {
+    RejectJavascriptCallback(args[0], base::Value("无法创建原生 Tab"));
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], context->GetState());
+}
+
+void ManagementUIHandler::HandleActivateManagedTab(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_string()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("缺少原生 Tab 标识"));
+    }
+    return;
+  }
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context || !context->Activate()) {
+    RejectJavascriptCallback(args[0], base::Value("无法激活原生 Tab"));
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+void ManagementUIHandler::HandleNavigateManagedTab(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 3 || !args[1].is_string() || !args[2].is_string()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("原生 Tab 导航参数无效"));
+    }
+    return;
+  }
+
+  const GURL url(args[2].GetString());
+  if (!url.is_valid()) {
+    RejectJavascriptCallback(args[0], base::Value("URL 参数无效"));
+    return;
+  }
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context || !context->NavigateTo(url)) {
+    RejectJavascriptCallback(args[0], base::Value("无法导航原生 Tab"));
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+void ManagementUIHandler::HandleCloseManagedTab(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_string()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("缺少原生 Tab 标识"));
+    }
+    return;
+  }
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context || !context->Close()) {
+    RejectJavascriptCallback(args[0], base::Value("无法关闭原生 Tab"));
+    return;
+  }
+
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+void ManagementUIHandler::HandleGetManagedTabStorageSnapshot(
+    const base::Value::List& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[1].is_string()) {
+    if (!args.empty()) {
+      RejectJavascriptCallback(args[0], base::Value("缺少原生 Tab 标识"));
+    }
+    return;
+  }
+
+  ManagedTabContext* context = ManagedTabContext::FindById(args[1].GetString());
+  if (!context) {
+    RejectJavascriptCallback(args[0], base::Value("原生 Tab 不存在"));
+    return;
+  }
+
+  context->GetStorageSnapshot(base::BindOnce(
+      &ManagementUIHandler::OnManagedTabStorageSnapshot,
+      weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void ManagementUIHandler::OnManagedTabStorageSnapshot(
+    base::Value callback_id,
+    ManagedTabContext::StorageSnapshot snapshot) {
+  base::Value::List cookies;
+  for (const net::CanonicalCookie& cookie : snapshot.cookies) {
+    base::Value::Dict cookie_data;
+    cookie_data.Set("name", cookie.Name());
+    cookie_data.Set("value", cookie.Value());
+    cookie_data.Set("domain", cookie.Domain());
+    cookie_data.Set("path", cookie.Path());
+    cookie_data.Set("secure", cookie.IsSecure());
+    cookie_data.Set("http_only", cookie.IsHttpOnly());
+    cookies.Append(std::move(cookie_data));
+  }
+
+  base::Value::Dict result;
+  result.Set("cookies", std::move(cookies));
+  result.Set("local_storage", std::move(snapshot.local_storage));
+  ResolveJavascriptCallback(callback_id, result);
+}
