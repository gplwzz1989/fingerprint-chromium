 namespace chrome {
 
+ManagedTabContext::ManagedTabContext(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<ManagedTabContext>(*web_contents),
+      id_(base::Uuid::GenerateRandomV4().AsLowercaseString()),
+      current_url_(web_contents->GetURL()) {}
+
+ManagedTabContext::~ManagedTabContext() = default;
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ManagedTabContext);
+
+void ManagedTabContext::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInPrimaryMainFrame() ||
+      !navigation_handle->HasCommitted()) {
+    return;
+  }
+
+  current_url_ = navigation_handle->GetURL();
+}
+
+void ManagedTabContext::LoadProgressChanged(double progress) {
+  load_progress_ = progress;
+}
+
+void ManagedTabContext::TitleWasSet(content::NavigationEntry* entry) {
+  if (entry) {
+    title_ = entry->GetTitle();
+  }
+}
 
