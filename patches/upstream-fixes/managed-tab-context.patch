+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MANAGED_TAB_MANAGED_TAB_CONTEXT_H_
+#define CHROME_BROWSER_MANAGED_TAB_MANAGED_TAB_CONTEXT_H_
+
+#include <string>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace content {
+class NavigationEntry;
+class NavigationHandle;
+}  // namespace content
+
+namespace chrome {
+
+// Stores the browser-managed identity and runtime state for one native tab.
+// The object is attached to WebContents so later account isolation features can
+// resolve the managed environment from the active tab without using globals.
+class ManagedTabContext final
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<ManagedTabContext> {
+ public:
+  ManagedTabContext(const ManagedTabContext&) = delete;
+  ManagedTabContext& operator=(const ManagedTabContext&) = delete;
+
+  ~ManagedTabContext() override;
+
+  const std::string& id() const { return id_; }
+  const GURL& current_url() const { return current_url_; }
+  const std::u16string& title() const { return title_; }
+  double load_progress() const { return load_progress_; }
+
+ private:
+  friend class content::WebContentsUserData<ManagedTabContext>;
+
+  explicit ManagedTabContext(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void LoadProgressChanged(double progress) override;
+  void TitleWasSet(content::NavigationEntry* entry) override;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  const std::string id_;
+  GURL current_url_;
+  std::u16string title_;
+  double load_progress_ = 0.0;
+};
+
+}  // namespace chrome
+
+#endif  // CHROME_BROWSER_MANAGED_TAB_MANAGED_TAB_CONTEXT_H_
