diff --git a/chrome/browser/ui/browser_tab_strip_model_delegate.cc b/chrome/browser/ui/browser_tab_strip_model_delegate.cc
--- a/chrome/browser/ui/browser_tab_strip_model_delegate.cc
+++ b/chrome/browser/ui/browser_tab_strip_model_delegate.cc
@@ -10,5 +10,6 @@
 #include "base/feature_list.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/functional/callback_helpers.h"
+#include "base/strings/utf_string_conversions.h"
 #include "base/uuid.h"
@@ -102,23 +102,49 @@ std::string ManagedTabContext::GenerateId() {
 // static
-ManagedTabContext* ManagedTabContext::FindById(const std::string& id) {
+std::vector<ManagedTabContext*> ManagedTabContext::GetAll() {
+  std::vector<ManagedTabContext*> contexts;
   for (Browser* browser : *BrowserList::GetInstance()) {
     if (!browser || !browser->tab_strip_model()) {
       continue;
     }
 
     TabStripModel* tab_strip_model = browser->tab_strip_model();
     for (int index = 0; index < tab_strip_model->count(); ++index) {
       content::WebContents* contents =
           tab_strip_model->GetWebContentsAt(index);
       ManagedTabContext* tab_context =
           ManagedTabContext::FromWebContents(contents);
-      if (tab_context && tab_context->id() == id) {
-        return tab_context;
+      if (tab_context) {
+        contexts.push_back(tab_context);
       }
     }
   }
 
+  return contexts;
+}
+
+// static
+ManagedTabContext* ManagedTabContext::FindById(const std::string& id) {
+  for (ManagedTabContext* context : GetAll()) {
+    if (context->id() == id) {
+      return context;
+    }
+  }
+
   return nullptr;
 }
 
+base::Value::Dict ManagedTabContext::GetState() const {
+  base::Value::Dict state;
+  state.Set("id", id_);
+  state.Set("url", current_url_.spec());
+  state.Set("title", base::UTF16ToUTF8(title_));
+  state.Set("load_progress", load_progress_);
+  state.Set("storage_partition", storage_partition_config_.partition_name());
+  state.Set("storage_partition_persistent",
+            !storage_partition_config_.in_memory());
+  state.Set("hardware_concurrency", fingerprint_hardware_concurrency_);
+  state.Set("user_agent", fingerprint_user_agent_override_.ua_string_override);
+  return state;
+}
