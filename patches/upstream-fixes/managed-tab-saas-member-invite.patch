+  protected canManageMembers_(): boolean {
+    const workspace = this.saasWorkspaces_.find(
+        item => item.workspace_id === this.saasWorkspaceId_);
+    return workspace?.role === 'owner' || workspace?.role === 'admin';
+  }
+
+  protected async onSaasInviteMember_() {
+    if (!this.saasClient_ || !this.saasWorkspaceId_ || this.saasBusy_) {
+      return;
+    }
+    const emailInput =
+        this.shadowRoot.querySelector<HTMLInputElement>('#saasInviteEmail');
+    const roleInput =
+        this.shadowRoot.querySelector<HTMLSelectElement>('#saasInviteRole');
+    const email = emailInput?.value.trim() || '';
+    const role = roleInput?.value || '';
+    if (!email || !role) {
+      this.saasError_ = '请输入受邀邮箱并选择成员角色';
+      return;
+    }
+
+    this.saasBusy_ = true;
+    this.saasError_ = '';
+    this.saasInviteToken_ = '';
+    try {
+      const invite = await this.saasClient_.createWorkspaceInvite(
+          this.saasWorkspaceId_, email, role);
+      this.saasInviteToken_ = invite.invite_token;
+      this.saasError_ = `邀请已生成，有效期至 ${invite.expires_at}；请通过受控渠道交给受邀用户`;
+      if (emailInput) {
+        emailInput.value = '';
+      }
+    } catch (error) {
+      this.saasError_ = getSaasErrorMessage(error);
+    } finally {
+      this.saasBusy_ = false;
+    }
+  }
+
+  protected onCopySaasInviteToken_() {
+    if (!this.saasInviteToken_) {
+      return;
+    }
+    if (!navigator.clipboard) {
+      this.saasError_ = '当前页面不支持复制，请手动复制邀请令牌';
+      return;
+    }
+    navigator.clipboard.writeText(this.saasInviteToken_).then(
+        () => this.saasError_ = '邀请令牌已复制，请仅通过受控渠道发送',
+        () => this.saasError_ = '复制邀请令牌失败，请手动复制');
+  }
