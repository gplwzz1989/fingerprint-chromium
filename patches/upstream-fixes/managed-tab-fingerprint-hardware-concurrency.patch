+bool ManagedTabContext::SetFingerprintHardwareConcurrency(
+    int hardware_concurrency) {
+  if (!web_contents() || hardware_concurrency < 0 || hardware_concurrency > 64) {
+    return false;
+  }
+
+  fingerprint_hardware_concurrency_ = hardware_concurrency;
+  if (hardware_concurrency == 0) {
+    blink::web_pref::WebPreferences preferences =
+        web_contents()->GetOrCreateWebPreferences();
+    preferences.number_of_cpu_cores = 0;
+    web_contents()->SetWebPreferences(preferences);
+    return true;
+  }
+
+  ApplyFingerprintHardwareConcurrencyOverride();
+  return true;
+}
+
+void ManagedTabContext::ApplyFingerprintHardwareConcurrencyOverride() {
+  if (!web_contents() || fingerprint_hardware_concurrency_ == 0) {
+    return;
+  }
+
+  blink::web_pref::WebPreferences preferences =
+      web_contents()->GetOrCreateWebPreferences();
+  // Managed Tabs carry the fingerprint switch into their renderer, so a
+  // positive value here is the per-Tab hardware concurrency override.
+  preferences.number_of_cpu_cores = fingerprint_hardware_concurrency_;
+  web_contents()->SetWebPreferences(preferences);
+}
