+std::optional<unsigned> GetManagedHardwareConcurrency(
+    ExecutionContext* execution_context) {
+  if (!execution_context || !execution_context->IsWindow()) {
+    return std::nullopt;
+  }
+
+  auto* window = To<LocalDOMWindow>(execution_context);
+  if (!window->GetFrame() || !window->GetFrame()->GetPage()) {
+    return std::nullopt;
+  }
+
+  WebViewImpl* web_view =
+      window->GetFrame()->GetPage()->GetChromeClient().GetWebView();
+  if (!web_view) {
+    return std::nullopt;
+  }
+
+  const int configured_value =
+      web_view->GetWebPreferences().number_of_cpu_cores;
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kFingerprint) &&
+      configured_value > 0 && configured_value <= 64) {
+    return static_cast<unsigned>(configured_value);
+  }
+
+  return std::nullopt;
+}
