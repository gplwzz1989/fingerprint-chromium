@@ -118,6 +118,11 @@ base::flat_map<std::string, int>& ManagedTabRestoreHardwareConcurrency() {
   return *values;
 }
 
+base::flat_map<std::string, std::string>& ManagedTabRestoreUserAgents() {
+  static base::NoDestructor<base::flat_map<std::string, std::string>>
