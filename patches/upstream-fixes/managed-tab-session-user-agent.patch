 bool ParseManagedTabProxyRules(const std::string& proxy_rules,
                                net::ProxyConfig::ProxyRules* parsed_rules) {
@@ -398,1 +398,8 @@ bool ManagedTabContext::PrepareSessionRestore(
+  const auto user_agent = extra_data.find(kSessionUserAgentKey);
+  const std::string user_agent_value =
+      user_agent == extra_data.end() ? std::string() : user_agent->second;
+  if (user_agent_value.size() > 512) {
+    return false;
+  }
+
   if (proxy_rules_value.empty()) {
@@ -411,5 +424,6 @@ bool ManagedTabContext::PrepareSessionRestore(
           : fingerprint_seed_value;
   ManagedTabRestoreHardwareConcurrency()[managed_tab_id->second] =
       hardware_concurrency;
+  ManagedTabRestoreUserAgents()[managed_tab_id->second] = user_agent_value;
   return true;
 }
@@ -449,6 +463,18 @@ int ManagedTabContext::GetSessionHardwareConcurrencyForId(
   return hardware_concurrency;
 }
 
+// static
+std::string ManagedTabContext::GetSessionUserAgentForId(
+    const std::string& id) {
+  auto it = ManagedTabRestoreUserAgents().find(id);
+  if (it == ManagedTabRestoreUserAgents().end()) {
+    return std::string();
+  }
+
+  std::string user_agent = std::move(it->second);
+  ManagedTabRestoreUserAgents().erase(it);
+  return user_agent;
+}
 
 // static
 void ManagedTabContext::ConfigureNetworkContextParams(
@@ -632,11 +659,16 @@ ManagedTabContext::ManagedTabContext(content::WebContents* web_contents)
       current_url_(web_contents->GetURL()),
       fingerprint_user_agent_override_(web_contents->GetUserAgentOverride()),
       fingerprint_hardware_concurrency_(
           GetSessionHardwareConcurrencyForId(id_)) {
+  const std::string session_user_agent = GetSessionUserAgentForId(id_);
+  if (!session_user_agent.empty()) {
+    SetFingerprintUserAgent(session_user_agent);
+  }
   ApplyFingerprintHardwareConcurrencyOverride();
 }
 
 ManagedTabContext::~ManagedTabContext() {
   ManagedTabProxyRules().erase(id_);
   ManagedTabFingerprintSeeds().erase(id_);
+  ManagedTabRestoreUserAgents().erase(id_);
 }
