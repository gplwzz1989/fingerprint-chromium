+std::optional<blink::UserAgentOverride>
+ChromeContentBrowserClient::GetManagedTabUserAgentOverride(
+    const content::StoragePartitionConfig& config) {
+  for (chrome::ManagedTabContext* tab : chrome::ManagedTabContext::GetAll()) {
+    if (tab->storage_partition_config() == config) {
+      const auto& override = tab->fingerprint_user_agent_override();
+      if (!override.ua_string_override.empty()) return override;
+    }
+  }
+  return std::nullopt;
+}
