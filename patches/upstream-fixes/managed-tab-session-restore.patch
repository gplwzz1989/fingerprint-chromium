+  auto it = ManagedTabRestoreHardwareConcurrency().find(id);
+  if (it == ManagedTabRestoreHardwareConcurrency().end()) {
+    return 0;
+  }
+
+  const int hardware_concurrency = it->second;
+  ManagedTabRestoreHardwareConcurrency().erase(it);
+  return hardware_concurrency;
+}
