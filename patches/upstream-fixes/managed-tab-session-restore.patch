+// static
+bool ManagedTabContext::PrepareSessionRestore(
+    const std::map<std::string, std::string>& extra_data) {
+  auto managed_tab_id = extra_data.find(kSessionManagedTabIdKey);
+  if (managed_tab_id == extra_data.end() ||
+      !IsValidId(managed_tab_id->second)) {
+    return false;
+  }
+
+  const auto proxy_rules = extra_data.find(kSessionProxyRulesKey);
+  const std::string proxy_rules_value =
+      proxy_rules == extra_data.end() ? std::string() : proxy_rules->second;
+  if (!IsValidNetworkProxy(proxy_rules_value)) {
+    return false;
+  }
+
+  const auto fingerprint_seed =
+      extra_data.find(kSessionFingerprintSeedKey);
+  const std::string fingerprint_seed_value =
+      fingerprint_seed == extra_data.end() ? std::string()
+                                            : fingerprint_seed->second;
+  if (!fingerprint_seed_value.empty() &&
+      !IsValidFingerprintSeed(fingerprint_seed_value)) {
+    return false;
+  }
+
+  int hardware_concurrency = 0;
+  const auto hardware_value = extra_data.find(kSessionHardwareConcurrencyKey);
+  if (hardware_value != extra_data.end() &&
+      (!base::StringToInt(hardware_value->second, &hardware_concurrency) ||
+       hardware_concurrency < 0 || hardware_concurrency > 64)) {
+    return false;
+  }
+
+  if (proxy_rules_value.empty()) {
+    ManagedTabProxyRules().erase(managed_tab_id->second);
+  } else {
+    ManagedTabProxyRules()[managed_tab_id->second] = proxy_rules_value;
+  }
+  ManagedTabFingerprintSeeds()[managed_tab_id->second] =
+      fingerprint_seed_value.empty()
+          ? GetFingerprintSeedForId(managed_tab_id->second)
+          : fingerprint_seed_value;
+  ManagedTabRestoreHardwareConcurrency()[managed_tab_id->second] =
+      hardware_concurrency;
+  return true;
+}
